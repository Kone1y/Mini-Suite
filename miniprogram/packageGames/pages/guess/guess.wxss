.page {
  min-height: 100vh;
  background: #F6F4EE;
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
  display: flex; flex-direction: column;
}

/* 顶栏 */
.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.mode-tabs {
  display: flex; background: #EBE8DF;
  border-radius: 999rpx; padding: 6rpx;
}
.tab { font-size: 25rpx; color: #8A8574; padding: 10rpx 26rpx; border-radius: 999rpx; }
.tab.on { background: #534AB7; color: #fff; font-weight: 600; }
.streak { font-size: 22rpx; color: #B0713A; font-family: monospace; }

/* 盘面 */
.board { display: flex; flex-direction: column; gap: 14rpx; }
.row { display: flex; flex-direction: column; gap: 6rpx; }
.row.ghost .cell { background: rgba(83,74,183,.04); }
.cell-group { display: flex; gap: 10rpx; }
.cell {
  flex: 1; height: 92rpx;
  background: #fff;
  border: 2rpx solid rgba(83,74,183,.12);
  border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 46rpx; font-weight: 700; color: #33312B;
}
.cell.dim { border-style: dashed; }
.cell.hit { background: #4C9E64; border-color: #4C9E64; color: #fff; }
.cell.present { background: #D9A62E; border-color: #D9A62E; color: #fff; }

/* 拼音反馈 */
.py-group { display: flex; gap: 10rpx; }
.py-cell {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 8rpx;
  background: rgba(83,74,183,.03);
  border-radius: 8rpx; padding: 4rpx 0;
}
.py-i, .py-f, .py-t { font-size: 20rpx; color: #A5A08F; font-family: monospace; }
.py-t { font-weight: 700; }
.py-i.hit, .py-f.hit, .py-t.hit { color: #fff; background: #4C9E64; border-radius: 6rpx; padding: 0 6rpx; }
.py-i.present, .py-f.present, .py-t.present { color: #fff; background: #D9A62E; border-radius: 6rpx; padding: 0 6rpx; }

.status { text-align: center; font-size: 24rpx; color: #8A8574; margin: 18rpx 0; }

/* 玩法说明 */
.help-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid rgba(83,74,183,.10);
}
.help-head { display: flex; justify-content: space-between; align-items: center; font-size: 26rpx; font-weight: 600; color: #534AB7; }
.help-arrow { font-size: 22rpx; color: #A5A08F; transition: transform .2s; display: inline-block; }
.help-arrow.open { transform: rotate(180deg); }
.help-body { margin-top: 16rpx; border-top: 2rpx solid rgba(83,74,183,.08); padding-top: 16rpx; }
.help-p { font-size: 24rpx; color: #6B675A; line-height: 1.7; margin-bottom: 8rpx; }
.help-p .em { font-weight: 700; color: #534AB7; }
.help-li { font-size: 23rpx; color: #8A8574; line-height: 1.8; padding-left: 16rpx; }
.demo { display: inline-block; color: #fff; border-radius: 6rpx; padding: 0 8rpx; font-size: 20rpx; }
.demo.hit { background: #4C9E64; }
.demo.present { background: #D9A62E; }
.demo.miss { background: #B8B3A2; }

/* 输入区 */
.input-area { margin-top: 4rpx; }
.search-box {
  display: flex; gap: 12rpx; align-items: center;
}
.inp {
  flex: 1; min-width: 0;
  background: #fff; border: 2rpx solid rgba(83,74,183,.14);
  border-radius: 999rpx; padding: 18rpx 28rpx;
  font-size: 28rpx; color: #33312B;
}
.ph { color: #B8B3A2; }
.method-btn {
  flex: none; font-size: 22rpx; color: #534AB7;
  border: 2rpx solid #534AB7; border-radius: 999rpx;
  padding: 12rpx 22rpx;
}
.cands {
  margin-top: 12rpx; background: #fff;
  border: 2rpx solid rgba(83,74,183,.10);
  border-radius: 18rpx; overflow: hidden;
}
.cand {
  display: flex; align-items: center; gap: 18rpx;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid #F0EDE4;
}
.cand:last-child { border-bottom: none; }
.cand:active { background: rgba(83,74,183,.06); }
.cand-w { font-size: 32rpx; font-weight: 700; color: #33312B; letter-spacing: 4rpx; }
.cand-p { font-size: 20rpx; color: #A5A08F; }
.empty-sug { padding: 18rpx; text-align: center; }
.cand-none { font-size: 24rpx; color: #A5A08F; }
.submit-btn {
  margin-top: 16rpx; text-align: center;
  background: linear-gradient(135deg, #6A5AE0, #534AB7);
  color: #fff; font-size: 30rpx; font-weight: 700;
  border-radius: 999rpx; padding: 20rpx 0;
}
.submit-btn:active { opacity: .85; }

/* 结算卡 */
.result-card {
  margin-top: 20rpx; background: #fff;
  border-radius: 22rpx; padding: 30rpx;
  border: 2rpx solid rgba(83,74,183,.10);
}
.rc-head { text-align: center; font-size: 34rpx; font-weight: 800; }
.rc-head.win { color: #4C9E64; }
.rc-head.lose { color: #C25B4E; }
.rc-word { text-align: center; font-size: 52rpx; font-weight: 800; color: #33312B; letter-spacing: 10rpx; margin-top: 14rpx; }
.rc-py { text-align: center; font-size: 22rpx; color: #A5A08F; margin-top: 6rpx; }
.rc-explain { font-size: 25rpx; color: #55524A; line-height: 1.7; margin-top: 16rpx; }
.rc-derive { font-size: 22rpx; color: #A5A08F; margin-top: 10rpx; line-height: 1.6; }
.rc-btns { display: flex; gap: 14rpx; margin-top: 22rpx; }
.rc-btn {
  flex: 1; text-align: center; font-size: 25rpx; color: #534AB7;
  border: 2rpx solid #534AB7; border-radius: 999rpx; padding: 14rpx 0;
}
.rc-btn.primary { background: #534AB7; color: #fff; }

/* 词典 */
.dict-entry {
  margin-top: 26rpx; text-align: center;
  font-size: 25rpx; color: #0F6E56;
  border: 2rpx dashed rgba(15,110,86,.35);
  border-radius: 999rpx; padding: 16rpx 0;
}
.dict-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(20,18,10,.55); z-index: 100;
  display: flex; align-items: flex-end;
}
.dict-panel {
  width: 100%; max-height: 78vh;
  background: #FDFCF8;
  border-radius: 30rpx 30rpx 0 0;
  padding: 30rpx 30rpx 40rpx;
  box-sizing: border-box;
  display: flex; flex-direction: column;
}
.dict-head { display: flex; justify-content: space-between; align-items: center; }
.dict-title { font-size: 32rpx; font-weight: 800; color: #33312B; }
.dict-close { font-size: 30rpx; color: #A5A08F; padding: 8rpx; }
.dict-search { display: flex; gap: 12rpx; margin-top: 20rpx; }
.dict-inp {
  flex: 1; min-width: 0; background: #fff;
  border: 2rpx solid rgba(83,74,183,.14);
  border-radius: 999rpx; padding: 14rpx 24rpx; font-size: 26rpx;
}
.dict-btn {
  background: #0F6E56; color: #fff;
  border-radius: 999rpx; padding: 14rpx 34rpx;
  font-size: 25rpx;
}
.dict-tip { font-size: 21rpx; color: #A5A08F; margin: 12rpx 4rpx 0; }
.dict-list { flex: 1; min-height: 300rpx; margin-top: 12rpx; }
.dict-item {
  background: #fff; border-radius: 16rpx;
  padding: 18rpx 22rpx; margin-bottom: 12rpx;
}
.di-w { font-size: 30rpx; font-weight: 700; color: #33312B; letter-spacing: 3rpx; display: inline-block; margin-right: 16rpx; }
.di-p { font-size: 20rpx; color: #A5A08F; display: inline-block; }
.di-e { font-size: 22rpx; color: #77746A; margin-top: 8rpx; line-height: 1.6; }
.dict-none { text-align: center; color: #A5A08F; font-size: 24rpx; padding: 60rpx 0; }

/* 词条详情 */
.dict-detail-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(20,18,10,.6); z-index: 110;
  display: flex; align-items: center; justify-content: center;
  padding: 60rpx;
}
.dd-card {
  width: 100%; background: #FDFCF8;
  border-radius: 26rpx; padding: 40rpx 34rpx;
  max-height: 70vh; overflow-y: auto;
}
.dd-word { text-align: center; font-size: 48rpx; font-weight: 800; letter-spacing: 8rpx; color: #33312B; }
.dd-py { text-align: center; font-size: 22rpx; color: #A5A08F; margin-top: 6rpx; }
.dd-explain { font-size: 26rpx; color: #55524A; line-height: 1.8; margin-top: 20rpx; }
.dd-derive { font-size: 22rpx; color: #A5A08F; margin-top: 14rpx; line-height: 1.6; }
.dd-example { font-size: 22rpx; color: #77746A; margin-top: 10rpx; line-height: 1.6; background: rgba(83,74,183,.05); border-radius: 12rpx; padding: 14rpx; }

.foot { text-align: center; color: #B5B1A4; font-size: 22rpx; padding: 30rpx 0 10rpx; }
