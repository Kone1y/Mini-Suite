.page {
  min-height: 100vh;
  background: #12121A;
  padding: 28rpx 28rpx 40rpx;
  box-sizing: border-box;
  display: flex; flex-direction: column;
}

/* 头部 */
.hero { margin-bottom: 30rpx; }
.hero-title { font-size: 44rpx; font-weight: 800; color: #E8E7F0; }
.hero-sub { font-size: 24rpx; color: #8A8574; margin-top: 8rpx; }

/* 玩法卡 */
.games { display: flex; flex-direction: column; gap: 18rpx; }
.game-card {
  display: flex; align-items: center; gap: 22rpx;
  background: rgba(22, 21, 34, 0.44);
  border-radius: 22rpx;
  padding: 26rpx 26rpx;
  border: 2rpx solid rgba(83,74,183,.10);
}
.game-card:active { opacity: .85; }
.game-card.hard { background: linear-gradient(135deg, #534AB7 0%, #7A5BE0 100%); border: none; }
.game-card.hard .gc-name { color: #fff; }
.game-card.hard .gc-sub { color: rgba(255,255,255,.75); }
.game-card.hard .gc-diff { background: rgba(255,255,255,.2); color: #FFD66B; }
.game-card.hard .gc-tag { color: rgba(255,255,255,.6); }
.game-card.hard .gc-arrow { color: rgba(255,255,255,.7); }
.gc-icon {
  width: 88rpx; height: 88rpx;
  background: rgba(83,74,183,.08);
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
}
.game-card.hard .gc-icon { background: rgba(255,255,255,.18); }
.gc-main { flex: 1; min-width: 0; }
.gc-name-row { display: flex; align-items: center; gap: 12rpx; }
.gc-name { font-size: 30rpx; font-weight: 700; color: #E8E7F0; }
.gc-diff {
  font-size: 19rpx; padding: 2rpx 12rpx; border-radius: 999rpx;
  background: rgba(76,158,100,.12); color: #4C9E64;
}
.gc-sub { font-size: 23rpx; color: #8A8574; margin-top: 6rpx; }
.gc-tag { font-size: 20rpx; color: #A5A08F; margin-top: 4rpx; }
.gc-arrow { font-size: 40rpx; color: #C9C4B4; font-weight: 300; }

/* 词典横幅 */
.dict-banner {
  display: flex; align-items: center; gap: 22rpx;
  background: rgba(22, 21, 34, 0.44);
  border: 2rpx dashed rgba(176,113,58,.4);
  border-radius: 22rpx;
  padding: 24rpx 26rpx;
  margin-top: 22rpx;
}
.dict-banner:active { opacity: .85; }
.db-icon {
  width: 88rpx; height: 88rpx;
  background: rgba(176,113,58,.10);
  border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
}
.db-main { flex: 1; min-width: 0; }
.db-name { font-size: 30rpx; font-weight: 700; color: #B0713A; }
.db-sub { font-size: 23rpx; color: #A5A08F; margin-top: 6rpx; }

.foot {
  text-align: center; font-size: 24rpx; color: #A5A08F;
  margin-top: 46rpx; padding: 16rpx;
}
