.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F4E1 0%, #F6F5F2 60%);
  padding: 24rpx;
  box-sizing: border-box;
}

/* 顶栏 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.score-box { text-align: center; min-width: 120rpx; }
.score-num { font-size: 48rpx; font-weight: 800; color: #534AB7; font-family: monospace; line-height: 1.1; }
.score-num.combo { color: #D84343; }
.score-label { font-size: 20rpx; color: #9B98A8; margin-top: 4rpx; }
.time-box { flex: 1; margin: 0 24rpx; text-align: center; }
.time-num { font-size: 40rpx; font-weight: 700; color: #2C2C2A; font-family: monospace; }
.time-num.danger { color: #D84343; }
.time-bar {
  margin-top: 8rpx;
  height: 10rpx;
  background: #E8E6DF;
  border-radius: 999rpx;
  overflow: hidden;
}
.time-fill {
  height: 100%;
  background: linear-gradient(90deg, #6BCB77 0%, #534AB7 100%);
  border-radius: 999rpx;
  transition: width 0.9s linear;
}

/* 地鼠场 */
.field { position: relative; }
.hole-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22rpx;
  padding: 30rpx 10rpx;
}
.hole {
  aspect-ratio: 1;
  position: relative;
  border-radius: 50%;
  background: radial-gradient(ellipse at 50% 35%, #C9A36B 0%, #A87F4E 55%, #8A6638 100%);
  box-shadow: inset 0 -10rpx 18rpx rgba(0,0,0,0.25), 0 6rpx 16rpx rgba(44,44,42,0.12);
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.dirt {
  position: absolute;
  left: 10%; right: 10%; bottom: 0;
  height: 26%;
  background: #6E5230;
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
}
.mole {
  position: relative;
  z-index: 2;
  width: 68%;
  margin-bottom: 8rpx;
  transform: translateY(110%);
  transition: transform 0.16s ease-out;
}
.mole.up { transform: translateY(8%); }
.mole.bonked { transform: translateY(30%) scale(0.9); }
.face {
  font-size: 88rpx;
  line-height: 1.15;
  text-align: center;
}

/* 遮罩 */
.mask {
  position: absolute;
  left: -10rpx; right: -10rpx; top: -10rpx; bottom: -10rpx;
  background: rgba(246, 245, 242, 0.94);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}
.mask-emoji { font-size: 96rpx; }
.mask-title { font-size: 40rpx; font-weight: 700; color: #2C2C2A; margin-top: 16rpx; }
.mask-sub { margin-top: 14rpx; color: #5F5E5A; font-size: 25rpx; text-align: center; line-height: 1.7; }
.mask-row { margin-top: 34rpx; }
.mask-btn {
  background: linear-gradient(135deg, #6A5AE0 0%, #534AB7 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  margin: 0;
  padding: 0 70rpx;
  line-height: 2.5;
}
.mask-btn::after { border: none; }
