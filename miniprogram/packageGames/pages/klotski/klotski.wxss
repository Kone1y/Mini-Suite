.page { display: flex; flex-direction: column; align-items: center; padding: 24rpx; }

.top-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 20rpx;
}
.info-box {
  background: #FFFFFF;
  border-radius: 14rpx;
  padding: 12rpx 26rpx;
  text-align: center;
  min-width: 130rpx;
  border: 1rpx solid #EFEEE9;
}
.info-label { font-size: 20rpx; color: #888780; }
.info-num { font-size: 32rpx; font-weight: 700; color: #26215C; font-family: monospace; }
.title-box { text-align: center; }
.game-title { font-size: 38rpx; font-weight: 800; color: #26215C; letter-spacing: 2rpx; }
.lv-tag {
  font-size: 20rpx;
  font-weight: 500;
  color: #534AB7;
  background: #EEEDFE;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 6rpx;
  vertical-align: middle;
}
.game-sub { font-size: 20rpx; color: #888780; margin-top: 4rpx; }

.level-panel { display: flex; gap: 14rpx; margin-bottom: 16rpx; }
.level-opt {
  background: #FFFFFF;
  border: 2rpx solid #EFEEE9;
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
  font-size: 24rpx;
  color: #5F5E5A;
}
.level-opt.on {
  border-color: #534AB7;
  color: #534AB7;
  background: #EEEDFE;
  font-weight: 600;
}

.board-wrap { position: relative; width: 100%; }
.board {
  width: 100%;
  display: grid;
  gap: 10rpx;
  background: #D9D7CE;
  border-radius: 16rpx;
  padding: 10rpx;
  box-sizing: border-box;
}
.cell { width: 100%; aspect-ratio: 1; }
.tile {
  width: 100%;
  height: 100%;
  background: linear-gradient(160deg, #FFFFFF 0%, #F4F2FC 100%);
  border-radius: 16rpx;
  border: 1rpx solid #EFEEE9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #534AB7;
  font-family: monospace;
  box-shadow: 0 4rpx 10rpx rgba(44, 44, 42, 0.08);
  transition: transform 0.1s ease;
}
.cell:active .tile { transform: scale(0.94); }

.mask {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(246, 245, 242, 0.92);
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.mask-title { font-size: 44rpx; font-weight: 800; color: #26215C; }
.mask-sub { font-size: 26rpx; color: #888780; margin: 14rpx 0 26rpx; }
.mask-btn {
  background: linear-gradient(135deg, #6A5AE0 0%, #534AB7 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(83, 74, 183, 0.3);
}
.mask-btn::after { border: none; }

.ctrl-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.ctrl-btn {
  background: linear-gradient(135deg, #6A5AE0 0%, #534AB7 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 0;
  flex: 1;
  min-width: 0;
  padding: 0 10rpx;
  white-space: nowrap;
}
.ctrl-btn.ghost {
  background: #FFFFFF;
  color: #534AB7;
  border: 2rpx solid #534AB7;
  box-shadow: none;
}
.ctrl-btn::after { border: none; }
.hint { margin-top: 18rpx; }
