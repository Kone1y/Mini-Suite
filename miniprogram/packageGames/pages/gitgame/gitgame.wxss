.page {
  min-height: 100vh; background: #14131C;
  padding: 24rpx 28rpx 40rpx; box-sizing: border-box;
  display: flex; flex-direction: column;
}

/* 选关 */
.hero { margin-bottom: 26rpx; }
.hero-t { font-size: 44rpx; font-weight: 800; color: #E8E4F5; }
.hero-s { font-size: 23rpx; color: #776F9E; margin-top: 8rpx; }
.lv-list { display: flex; flex-direction: column; gap: 14rpx; }
.lv-item {
  display: flex; align-items: center; gap: 20rpx;
  background: #232233; border-radius: 18rpx; padding: 22rpx 22rpx;
  border: 2rpx solid rgba(139,155,212,.10);
}
.lv-item:active { opacity: .85; }
.lv-item.passed { border-color: rgba(76,158,100,.4); }
.lv-dot {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: #3A3846; color: #B9B3D4;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; flex-shrink: 0;
}
.lv-dot.done { background: #4C9E64; color: #fff; }
.lv-main { flex: 1; min-width: 0; }
.lv-name { font-size: 28rpx; font-weight: 700; color: #E8E4F5; }
.lv-cat { font-size: 18rpx; color: #9C8FF5; background: rgba(83,74,183,.2); padding: 2rpx 10rpx; border-radius: 999rpx; margin-left: 10rpx; }
.lv-goal { font-size: 21rpx; color: #9C93C4; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lv-best { font-size: 22rpx; color: #FFD66B; font-family: monospace; flex-shrink: 0; }

/* 游玩头 */
.play-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.back-btn {
  width: 56rpx; height: 56rpx; border-radius: 14rpx;
  background: #3A3846; color: #E8E4F5;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; flex-shrink: 0;
}
.ph-main { flex: 1; min-width: 0; }
.ph-name { font-size: 28rpx; font-weight: 700; color: #E8E4F5; }
.ph-goal { font-size: 21rpx; color: #9C93C4; margin-top: 4rpx; }
.ph-count { font-size: 26rpx; color: #FFD66B; font-family: monospace; flex-shrink: 0; }

.goal-detail {
  background: rgba(83,74,183,.12); border-radius: 14rpx;
  padding: 18rpx 22rpx; margin-bottom: 14rpx;
}
.gd-row { font-size: 22rpx; color: #C9C0FF; line-height: 1.7; }
.gd-hint { color: #FFD66B; }

/* canvas */
.canvas-wrap {
  width: 100%; height: 380rpx;
  background: #14131C; border-radius: 18rpx; overflow: hidden;
  border: 2rpx solid rgba(139,155,212,.12);
  margin-bottom: 16rpx;
}
.git-canvas { width: 100%; height: 100%; }

/* 终端 */
.terminal {
  background: #0D0C14; border-radius: 14rpx;
  padding: 16rpx 20rpx; min-height: 120rpx; max-height: 260rpx;
  overflow-y: auto; margin-bottom: 16rpx;
}
.t-line { display: flex; flex-direction: column; margin-bottom: 8rpx; }
.t-cmd { font-size: 21rpx; color: #4C9E64; font-family: monospace; }
.t-out { font-size: 20rpx; color: #B9B3D4; font-family: monospace; white-space: pre-wrap; }
.t-out.dim { color: #55506E; }
.t-line.err .t-out { color: #E08080; }

/* 过关 */
.won-banner {
  background: rgba(76,158,100,.15); border: 2rpx solid rgba(76,158,100,.5);
  border-radius: 16rpx; padding: 20rpx; text-align: center; margin-bottom: 16rpx;
}
.wb-t { font-size: 26rpx; font-weight: 700; color: #6FC486; }
.wb-btns { display: flex; gap: 14rpx; margin-top: 16rpx; }
.wb-btn {
  flex: 1; background: #4C9E64; color: #fff;
  border-radius: 999rpx; padding: 16rpx 0; font-size: 25rpx; font-weight: 700;
}
.wb-btn.ghost { background: transparent; border: 2rpx solid #4C9E64; color: #6FC486; }

/* 命令区 */
.cmd-area { margin-top: auto; }
.quick-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 12rpx; }
.q-chip {
  background: #2C2B3C; color: #9C8FF5;
  border: 1rpx solid rgba(156,143,245,.3);
  border-radius: 999rpx; padding: 8rpx 20rpx;
  font-size: 21rpx; font-family: monospace;
}
.q-chip:active { opacity: .7; }
.cmd-row { display: flex; gap: 12rpx; }
.cmd-inp {
  flex: 1; min-width: 0;
  background: #0D0C14; color: #6FC486;
  border: 2rpx solid rgba(139,155,212,.2);
  border-radius: 12rpx; padding: 18rpx 22rpx;
  font-size: 27rpx; font-family: monospace;
}
.run-btn {
  background: #534AB7; color: #fff; border-radius: 12rpx;
  padding: 18rpx 36rpx; font-size: 27rpx; font-weight: 700; flex-shrink: 0;
}
.run-btn:active { opacity: .8; }
.status-line { font-size: 21rpx; color: #776F9E; text-align: center; margin-top: 10rpx; }

.foot { text-align: center; font-size: 23rpx; color: #776F9E; margin-top: 26rpx; padding: 14rpx; }
