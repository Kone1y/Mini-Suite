.page {
  min-height: 100vh; background: #14131C;
  padding: 24rpx 28rpx 40rpx; box-sizing: border-box;
  display: flex; flex-direction: column;
}

.hero { margin-bottom: 24rpx; }
.hero-t { font-size: 42rpx; font-weight: 800; color: #E8E4F5; }
.hero-s { font-size: 22rpx; color: #776F9E; margin-top: 8rpx; }

.lv-list { display: flex; flex-direction: column; gap: 14rpx; }
.lv-item {
  display: flex; align-items: center; gap: 18rpx;
  background: #232233; border-radius: 16rpx; padding: 22rpx;
  border: 2rpx solid rgba(139,155,212,.10);
}
.lv-item:active { opacity: .85; }
.lv-item.passed { border-color: rgba(76,158,100,.45); }
.lv-dot {
  width: 52rpx; height: 52rpx; border-radius: 14rpx; flex-shrink: 0;
  background: #3A3846; color: #B9B3D4;
  display: flex; align-items: center; justify-content: center;
  font-size: 23rpx; font-weight: 700;
}
.lv-dot.ok { background: #4C9E64; color: #fff; }
.lv-main { flex: 1; min-width: 0; }
.lv-name { font-size: 27rpx; font-weight: 700; color: #E8E4F5; }
.lv-cat { font-size: 18rpx; color: #9C8FF5; background: rgba(83,74,183,.2); padding: 2rpx 10rpx; border-radius: 999rpx; margin-left: 8rpx; }
.lv-desc { font-size: 20rpx; color: #9C93C4; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.play-head { display: flex; align-items: center; gap: 14rpx; margin-bottom: 14rpx; }
.back-btn {
  width: 56rpx; height: 56rpx; border-radius: 14rpx; flex-shrink: 0;
  background: #3A3846; color: #E8E4F5;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
}
.ph-name { font-size: 28rpx; font-weight: 700; color: #E8E4F5; flex: 1; }
.ph-count { font-size: 25rpx; color: #FFD66B; font-family: monospace; }

.lesson-card {
  background: rgba(83,74,183,.12); border-radius: 14rpx;
  padding: 18rpx 22rpx; margin-bottom: 14rpx;
}
.lc-t { font-size: 22rpx; color: #C9C0FF; line-height: 1.7; }

/* 缓冲区 */
.buffer {
  background: #0D0C14; border-radius: 14rpx;
  padding: 18rpx 8rpx; margin-bottom: 14rpx;
  min-height: 140rpx;
}
.buf-line {
  display: flex; align-items: center;
  font-family: 'Courier New', monospace;
  font-size: 27rpx; line-height: 1.9;
  color: #D8D4E8;
}
.buf-num {
  width: 52rpx; text-align: right; margin-right: 16rpx;
  color: #55506E; font-size: 20rpx; flex-shrink: 0;
}
.buf-line.active .buf-num { color: #9C8FF5; }
.buf-text { flex: 1; min-width: 0; white-space: pre; }
.caret {
  background: #4C9E64; color: #0D0C14;
  border-radius: 4rpx; font-weight: 800;
  padding: 0 2rpx;
}

.key-display {
  display: flex; align-items: baseline; gap: 10rpx;
  background: #232233; border-radius: 12rpx;
  padding: 14rpx 20rpx; margin-bottom: 8rpx;
}
.kd-label { font-size: 21rpx; color: #776F9E; flex-shrink: 0; }
.kd-keys { font-size: 26rpx; color: #6FC486; font-family: monospace; font-weight: 700; }
.kd-err { font-size: 21rpx; color: #E08080; margin-bottom: 10rpx; padding-left: 8rpx; }

.won-banner {
  background: rgba(76,158,100,.15); border: 2rpx solid rgba(76,158,100,.5);
  border-radius: 16rpx; padding: 20rpx; text-align: center; margin-bottom: 14rpx;
}
.wb-t { font-size: 25rpx; font-weight: 700; color: #6FC486; }
.wb-btns { display: flex; gap: 14rpx; margin-top: 16rpx; }
.wb-btn { flex: 1; background: #4C9E64; color: #fff; border-radius: 999rpx; padding: 16rpx 0; font-size: 24rpx; font-weight: 700; }
.wb-btn.ghost { background: transparent; border: 2rpx solid #4C9E64; color: #6FC486; }

/* 键盘 */
.keypad { margin-top: auto; display: flex; flex-direction: column; gap: 10rpx; }
.k-row { display: flex; gap: 10rpx; }
.k {
  flex: 1; min-width: 0;
  background: #2C2B3C; color: #C9C0FF;
  border: 1rpx solid rgba(156,143,245,.25);
  border-radius: 12rpx;
  height: 76rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 27rpx; font-family: monospace; font-weight: 700;
}
.k:active { opacity: .6; }
.k.num { color: #FFD66B; }
.k.wide { flex: 1.4; }
.k.back { flex: 1; color: #E08080; }
.k.enter { flex: 4; background: #534AB7; color: #fff; border: none; }

.foot { text-align: center; font-size: 22rpx; color: #776F9E; margin-top: 22rpx; padding: 12rpx; }
