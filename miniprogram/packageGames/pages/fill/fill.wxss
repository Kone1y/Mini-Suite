.page {
  min-height: 100vh; background: #F6F4EE;
  padding: 24rpx 28rpx 40rpx; box-sizing: border-box;
  display: flex; flex-direction: column;
}

.topbar {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 14rpx;
}
.lives { font-size: 28rpx; font-weight: 700; color: #C0564B; letter-spacing: 2rpx; }
.streak { font-size: 30rpx; font-weight: 800; color: #534AB7; }
.timer { font-size: 26rpx; color: #8A8574; font-family: monospace; font-weight: 700; }
.timer.urgent { color: #C0564B; }

.timebar {
  height: 8rpx; background: rgba(83,74,183,.10);
  border-radius: 999rpx; overflow: hidden; margin-bottom: 26rpx;
}
.timefill {
  height: 100%; background: linear-gradient(90deg, #534AB7, #7A5BE0);
  border-radius: 999rpx;
  transition: width 1s linear;
}

.q-area {
  background: #fff; border-radius: 24rpx;
  padding: 30rpx 28rpx;
  border: 2rpx solid rgba(83,74,183,.10);
}
.q-label { font-size: 23rpx; color: #8A8574; margin-bottom: 22rpx; }

/* 词格 */
.word-row { display: flex; gap: 14rpx; justify-content: center; }
.wcell {
  width: 108rpx; height: 108rpx;
  display: flex; align-items: center; justify-content: center;
  background: #F6F4EE;
  border: 2rpx solid rgba(83,74,183,.12);
  border-radius: 18rpx;
}
/* 所有字统一度量：行内 text + 相同 line-height，保证基线对齐 */
.wcell .given {
  font-size: 52rpx; font-weight: 800; color: #33312B;
  line-height: 1;
}
.wcell.blank { background: #fff; border: 2rpx dashed #B9B3D4; }
.wcell.blank.sel {
  border: 3rpx solid #534AB7;
  background: rgba(83,74,183,.06);
  box-shadow: 0 0 0 4rpx rgba(83,74,183,.10);
}
.wcell.blank .ph {
  font-size: 44rpx; font-weight: 700; color: #C9C4B4;
  line-height: 1;
}
.wcell.blank .given.filled { color: #534AB7; }

/* 候选字 */
.chars {
  display: flex; flex-wrap: wrap; gap: 16rpx;
  margin-top: 30rpx; justify-content: center;
}
.char {
  width: 88rpx; height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; font-weight: 700; color: #33312B;
  background: #fff;
  border: 2rpx solid rgba(83,74,183,.18);
  border-radius: 16rpx;
}
.char:active { opacity: .8; }
.char.used { opacity: .2; }

.after { margin-top: 26rpx; display: flex; flex-direction: column; gap: 14rpx; }
.verdict { text-align: center; font-size: 26rpx; font-weight: 700; }
.verdict.ok { color: #4C9E64; }
.verdict.no { color: #C0564B; }
.ex-line { font-size: 22rpx; color: #8A8574; line-height: 1.6; }
.next-btn {
  background: #534AB7; color: #fff;
  border-radius: 999rpx; padding: 20rpx 0;
  text-align: center; font-size: 28rpx; font-weight: 700;
}

.loading { text-align: center; color: #A5A08F; font-size: 26rpx; padding: 160rpx 0; }

.over-card {
  background: #fff; border-radius: 24rpx;
  padding: 50rpx 36rpx; text-align: center;
  border: 2rpx solid rgba(83,74,183,.10);
  margin-top: 60rpx;
}
.ov-emoji { font-size: 70rpx; }
.ov-t { font-size: 36rpx; font-weight: 800; color: #33312B; margin-top: 14rpx; }
.ov-line { font-size: 28rpx; color: #534AB7; font-weight: 700; margin-top: 16rpx; }
.ov-sub { font-size: 23rpx; color: #A5A08F; margin-top: 8rpx; }
.ov-btns { display: flex; gap: 16rpx; margin-top: 34rpx; }
.btn {
  flex: 1; min-width: 0;
  border-radius: 999rpx; padding: 20rpx 0;
  text-align: center; font-size: 27rpx;
  background: #F6F4EE; color: #33312B;
  border: 2rpx solid rgba(83,74,183,.14);
}
.btn.primary { background: #534AB7; color: #fff; font-weight: 700; border: none; }

.foot { text-align: center; font-size: 24rpx; color: #A5A08F; margin-top: 40rpx; padding: 16rpx; }
