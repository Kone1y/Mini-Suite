.page {
  min-height: 100vh;
  background: #F0EFEA;
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.title { font-size: 34rpx; font-weight: 800; color: #26215C; }
.status { font-size: 24rpx; color: #534AB7; }

/* 控制面板 */
.panel {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 14rpx rgba(83, 74, 183, 0.10);
  margin-bottom: 24rpx;
}
.row { display: flex; align-items: center; margin-bottom: 18rpx; }
.row.stat { margin-bottom: 0; font-size: 24rpx; color: #5F5E5A; }
.lbl { font-size: 26rpx; color: #5F5E5A; width: 80rpx; flex-shrink: 0; }
.picker {
  background: #EEEDFE;
  color: #534AB7;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.slider { flex: 1; min-width: 0; }

.btns {
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
  flex-wrap: wrap;
}
.btn {
  flex: 1;
  min-width: 0;
  background: #FFFFFF;
  border: 1rpx solid #EFEEE9;
  border-radius: 999rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #5F5E5A;
  white-space: nowrap;
}
.btn.primary {
  background: linear-gradient(135deg, #6A5AE0 0%, #534AB7 100%);
  color: #FFFFFF;
  border: none;
  font-weight: 600;
}
.btn.ghost {
  background: #FFFFFF;
  color: #534AB7;
  border: 2rpx solid #534AB7;
}
.btn.full { width: 100%; }

/* 棋盘 */
.board-wrap { width: 100%; display: flex; justify-content: center; }
.board {
  display: grid;
  gap: 0;
  background: #FFFFFF;
  border-radius: 12rpx;
  padding: 8rpx;
  box-sizing: border-box;
}
.cell {
  box-sizing: border-box;
  background: #FFFFFF;
}
.cell.start { background: #3FAE6B; }
.cell.end { background: #E05C5C; }
.cell.v { background: #E8E5FB; }
.cell.p { background: #534AB7; }
.cell.reach { background: #FFE08A; }
.cell.player {
  background: #FFC83D;
  box-shadow: inset 0 0 0 2rpx #534AB7;
}

.hint {
  font-size: 22rpx;
  color: #B4B2A9;
  margin-top: 18rpx;
  text-align: center;
}

.ctrl-row { margin-top: 24rpx; }
