page { background: #0A0A14; }
/* 不用 inset 简写（WXSS 不支持）——显式定位 */
.stage-wrap { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #0A0A14; }
.stage { width: 100%; height: 100%; }

/* 炸弹按钮（游戏内唯一原生按钮；两指触摸为兜底释放方式） */
.bomb-btn {
  position: absolute; right: 30rpx; bottom: 44rpx;
  width: 108rpx; height: 108rpx; border-radius: 50%;
  background: rgba(224, 107, 75, 0.18);
  border: 3rpx solid #E06B4B;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 18rpx rgba(224, 107, 75, 0.4);
}
.bomb-btn::before { content: '💣'; font-size: 40rpx; position: absolute; }
.bomb-num {
  position: absolute; bottom: 6rpx; right: 14rpx;
  font-size: 24rpx; font-weight: 800; color: #FFF;
  background: #E06B4B; border-radius: 999rpx;
  min-width: 30rpx; height: 30rpx; line-height: 30rpx;
  text-align: center;
}
.bomb-btn:active { transform: scale(0.92); }
