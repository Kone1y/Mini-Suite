.page {
  min-height: 100vh;
  background: linear-gradient(180deg, rgba(18,18,26,.92) 0%, #12121A 60%);
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 记分板 */
.scorebar {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}
.score {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(22, 21, 34, 0.44);
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(83, 74, 183, 0.10);
}
.chip { width: 30rpx; height: 30rpx; border-radius: 50%; }
.black-chip { background: #1C1B22; box-shadow: inset 0 -3rpx 5rpx rgba(255,255,255,0.15); }
.white-chip { background: rgba(22, 21, 34, 0.44); border: 2rpx solid #D8D6E8; }
.num { font-size: 38rpx; font-weight: 800; color: #C6C0FA; font-family: monospace; }
.who { font-size: 22rpx; color: #8B86B8; }
.turnbox { max-width: 45%; }
.turn {
  font-size: 24rpx;
  color: #A8A0F0;
  font-weight: 600;
  text-align: center;
}

/* 棋盘 */
.board {
  display: flex;
  flex-wrap: wrap;
  background: #1E7A46;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 122, 70, 0.35);
  overflow: hidden;
}
.cell {
  position: relative;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cell.last { background: #2C8A54; }
.disc { border-radius: 50%; }
.black-disc {
  background: radial-gradient(circle at 35% 30%, #4A4A55 0%, #1C1B22 65%);
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.35);
}
.white-disc {
  background: radial-gradient(circle at 35% 30%, #FFFFFF 0%, #E4E2EF 70%);
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.25);
}
.hint-dot {
  position: absolute;
  width: 22%;
  height: 22%;
  border-radius: 50%;
  background: rgba(22, 21, 34, 0.30);
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.8);
}
.last-mark {
  position: absolute;
  width: 26%;
  height: 26%;
  border-radius: 50%;
  border: 3rpx solid #FFD66B;
}

/* 结果 */
.result {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #A8A0F0;
  background: rgba(22, 21, 34, 0.44);
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(83, 74, 183, 0.18);
}

/* 控制行 */
.ctrl-row {
  display: flex;
  gap: 14rpx;
  width: 100%;
  margin-top: 22rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}
.btn {
  flex: 1;
  min-width: 0;
  background: rgba(22, 21, 34, 0.44);
  border: 1rpx solid rgba(255,255,255,.10);
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 25rpx;
  color: #C9C7DC;
  white-space: nowrap;
}
.btn.primary {
  background: linear-gradient(135deg, #6A5AE0 0%, #534AB7 100%);
  color: #FFFFFF;
  border: none;
  font-weight: 600;
}
.btn.ghost {
  background: rgba(22, 21, 34, 0.44);
  color: #A8A0F0;
  border: 2rpx solid #534AB7;
}
.btn:active { opacity: 0.8; }
.picker { flex: 1.3; min-width: 0; }

/* 说明卡 */
.intro-card {
  width: 100%;
  background: rgba(22, 21, 34, 0.44);
  border-radius: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(83, 74, 183, 0.10);
  margin-top: 24rpx;
  overflow: hidden;
}
.intro-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 26rpx;
}
.intro-title { font-size: 27rpx; font-weight: 700; color: #A8A0F0; }
.intro-arrow { font-size: 22rpx; color: #9B98AE; }
.intro-body { padding: 0 26rpx 22rpx; border-top: 1rpx solid #F0EEF8; }
.intro-li { font-size: 24rpx; color: #C9C7DC; line-height: 1.8; }
