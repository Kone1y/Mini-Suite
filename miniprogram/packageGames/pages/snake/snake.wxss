.page { display: flex; flex-direction: column; align-items: center; padding: 20rpx; }

.top-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 14rpx;
}
.info-box {
  background: rgba(22, 21, 34, 0.44);
  border-radius: 14rpx;
  padding: 12rpx 26rpx;
  text-align: center;
  min-width: 130rpx;
  border: 1rpx solid rgba(255,255,255,.10);
}
.info-label { font-size: 20rpx; color: #9C99B4; }
.info-num { font-size: 32rpx; font-weight: 700; color: #C6C0FA; font-family: monospace; }
.title-box { text-align: center; }
.game-title { font-size: 40rpx; font-weight: 800; color: #C6C0FA; letter-spacing: 2rpx; }
.game-sub { font-size: 20rpx; color: #9C99B4; margin-top: 2rpx; }

.board-wrap { position: relative; width: 100%; }
.board {
  width: 100%;
  display: grid;
  gap: 2rpx;
  background: rgba(255,255,255,.07);
  border-radius: 12rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border: 2rpx solid #E5E3DA;
}
.cell { width: 100%; aspect-ratio: 1; background: transparent; }

/* ===== 连贯蛇身：每节按连接方向定制圆角（JS 计算注入 style） ===== */
.cell.c1, .cell.c4 {
  background: #534AB7;
  /* 微微扩张盖住 grid gap，让相邻节无缝衔接 */
  margin: -1.5rpx;
  width: calc(100% + 3rpx);
  height: calc(100% + 3rpx);
}
/* 头：更亮 + 发光；撞死时变红 */
.cell.c4 {
  background: #6A5AE0;
  box-shadow: 0 0 10rpx rgba(106, 90, 224, 0.55);
}
.cell.c4.dead {
  background: #D84343;
  box-shadow: 0 0 12rpx rgba(216, 67, 67, 0.65);
}
/* 开始/暂停引导遮罩 */
.start-tip {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(246, 245, 242, 0.55);
  border-radius: 12rpx;
  z-index: 5;
}
.start-tip-icon { font-size: 72rpx; }
.start-tip-text {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #C9C7DC;
  background: rgba(22, 21, 34, 0.44);
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}
/* 食物 */
.cell.c9 {
  background: transparent;
  position: relative;
}
.cell.c9::after {
  content: '';
  position: absolute;
  left: 20%; top: 20%; right: 20%; bottom: 20%;
  background: #D84343;
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(216, 67, 67, 0.5);
}

.mask {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(22, 21, 34, 0.44);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.mask-title { font-size: 44rpx; font-weight: 800; color: #C6C0FA; }
.mask-sub { font-size: 26rpx; color: #9C99B4; margin: 14rpx 0 26rpx; }
.mask-btn {
  background: linear-gradient(135deg, #6A5AE0 0%, #534AB7 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 28rpx;
  margin: 0;
  box-shadow: 0 6rpx 16rpx rgba(83, 74, 183, 0.3);
}
.mask-btn::after { border: none; }

.dpad { margin-top: 24rpx; }
.dpad-row { display: flex; gap: 18rpx; justify-content: center; margin-top: 12rpx; }
.dbtn {
  width: 108rpx;
  height: 100rpx;
  background: rgba(22, 21, 34, 0.44);
  border: 1rpx solid rgba(255,255,255,.10);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #A8A0F0;
  box-shadow: 0 3rpx 8rpx rgba(44, 44, 42, 0.06);
}
.dbtn:active { transform: scale(0.94); background: rgba(106,90,224,.16); }

.ctrl-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  width: 100%;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.ctrl-btn {
  background: linear-gradient(135deg, #6A5AE0 0%, #534AB7 100%);
  color: #FFFFFF;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 0;
  flex: 1;
  min-width: 0;
  padding: 0 10rpx;
  white-space: nowrap;
}
.ctrl-btn.ghost {
  background: rgba(22, 21, 34, 0.44);
  color: #A8A0F0;
  border: 2rpx solid #534AB7;
  box-shadow: none;
}
.ctrl-btn::after { border: none; }
.hint { margin-top: 14rpx; }
