<view class="page" wx:if="{{order}}">
  <view class="status-card card">
    <view class="big-status">{{statusText}}</view>
    <view class="no">订单号 {{order.order_no}}</view>
    <view class="time">{{order.created_at}}</view>
  </view>

  <view class="card">
    <view class="sec">商品清单</view>
    <view class="line" wx:for="{{order.items}}" wx:key="index">
      <text>{{item.name}} × {{item.qty}}</text>
      <text class="price">¥{{item.price}}</text>
    </view>
    <view class="sum-line">
      <text>合计</text>
      <text class="sum">¥{{order.total}}</text>
    </view>
  </view>

  <view class="card">
    <view class="sec">收货信息（演示）</view>
    <view class="addr">{{order.address}}</view>
  </view>

  <view class="ops card" wx:if="{{order.status === 'pending'}}">
    <view class="op plain" bindtap="cancel">取消订单</view>
    <view class="op solid" bindtap="pay">模拟支付 ¥{{order.total}}</view>
  </view>
</view>
