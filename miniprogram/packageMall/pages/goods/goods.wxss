.goods-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 16rpx;
}
.goods-card {
  min-width: 0;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid #EFEEE9;
  box-shadow: 0 4rpx 14rpx rgba(44, 44, 42, 0.05);
}
.goods-img-wrap {
  position: relative;
  background: #F6F5F2;
}
.sold-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  background: rgba(216, 67, 67, 0.92);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  backdrop-filter: blur(4px);
}
.sold-badge.zero {
  background: rgba(83, 74, 183, 0.88);
}
.goods-card.ghost {
  background: transparent;
  border: none;
  box-shadow: none;
}
.goods-card.ghost:hover { box-shadow: none; }
.goods-img {
  width: 100%;
  height: 300rpx;
  display: block;
}
.goods-body {
  padding: 16rpx 18rpx 18rpx;
}
.goods-name {
  font-size: 26rpx;
  color: #2C2C2A;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
  min-height: 73rpx;
}
.goods-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 10rpx;
}
.goods-price { color: #D84343; font-weight: 700; }
.price-sym { font-size: 22rpx; }
.price-num { font-size: 32rpx; font-family: monospace; }
.goods-go {
  font-size: 20rpx;
  color: #B4B2A9;
  background: #F6F5F2;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
}

.load-line {
  text-align: center;
  color: #B4B2A9;
  font-size: 24rpx;
  padding: 24rpx 0 120rpx;
}
.load-line.empty { padding: 80rpx 0 120rpx; display: flex; flex-direction: column; align-items: center; gap: 10rpx; }
.empty-icon { font-size: 72rpx; }

.cart-fab {
  position: fixed;
  right: 30rpx;
  bottom: 80rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6A5AE0 0%, #534AB7 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(83, 74, 183, 0.45);
  border: 4rpx solid #FFFFFF;
  transition: transform 0.15s ease;
}
.fab-icon { font-size: 44rpx; line-height: 1; }
.fab-active { transform: scale(0.92); }
