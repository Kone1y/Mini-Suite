.page { padding: 24rpx; background: #12121A; min-height: 100vh; box-sizing: border-box; }
.card { background: rgba(22, 21, 34, 0.44); border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(83,74,183,0.08); }
.card-title { font-size: 32rpx; font-weight: 700; color: #A8A0F0; margin-bottom: 20rpx; }
.row { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.tinput { flex: 1; min-width: 0; border: 2rpx solid rgba(255,255,255,.14); border-radius: 12rpx; padding: 14rpx 18rpx; font-size: 28rpx; background: rgba(255,255,255,.07); }
.btn { background: #534AB7; color: #fff; border-radius: 12rpx; padding: 14rpx 26rpx; font-size: 27rpx; }
.btn.ghost { background: rgba(106,90,224,.16); color: #A8A0F0; }
.grid6 { display: flex; flex-wrap: wrap; gap: 12rpx; }
.grid6 .tinput { flex: 1 1 28%; min-width: 0; }
.err { color: #C0392B; font-size: 26rpx; margin-top: 14rpx; }
.ts-out { margin-top: 18rpx; background: rgba(255,255,255,.07); border-radius: 14rpx; padding: 16rpx 20rpx; }
.bit-line { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 27rpx; }
.bit-label { color: #888; }
.bit-line .mono { color: #2b2b35; font-weight: 600; text-align: right; max-width: 70%; }
.break { word-break: break-all; }
.mono { font-family: 'SF Mono', Menlo, Consolas, monospace; }
.foot { text-align: center; color: #aaa; font-size: 24rpx; padding: 20rpx 0 40rpx; }
