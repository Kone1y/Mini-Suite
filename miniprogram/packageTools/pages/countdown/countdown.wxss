.label { font-size: 26rpx; color: #C9C7DC; margin: 10rpx 0; }
.input {
  background: #12121A;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.picker-line { color: #E8E7F0; }
.item-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.item-title { font-size: 30rpx; font-weight: 600; }
.item-date { font-size: 24rpx; color: #9C99B4; }
.remain {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}
.unit { text-align: center; flex: 1; }
.num {
  font-size: 44rpx;
  font-weight: 600;
  color: #A8A0F0;
  font-family: monospace;
}
.u { font-size: 22rpx; color: #9C99B4; margin-left: 4rpx; }
.expired {
  margin-top: 20rpx;
  color: #993C1D;
  font-size: 28rpx;
}
.del {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #A32D2D;
  text-align: right;
}
