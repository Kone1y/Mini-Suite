.page { padding: 24rpx; background: #12121A; min-height: 100vh; box-sizing: border-box; }
.card { background: rgba(22, 21, 34, 0.44); border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(255,255,255,0.10); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.35); }
.card-title { font-size: 32rpx; font-weight: 700; color: #A8A0F0; margin-bottom: 12rpx; }
.hint { font-size: 24rpx; color: #9C99B4; line-height: 1.5; margin-bottom: 18rpx; }
.tarea { width: 100%; box-sizing: border-box; border: 2rpx solid rgba(255,255,255,.14); border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; background: rgba(255,255,255,.07); line-height: 1.5; min-height: 200rpx; color: #E8E7F0; }

.seg { display: flex; gap: 12rpx; margin-top: 18rpx; }
.seg-item { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx; font-size: 27rpx; color: #B9B4F2; background: rgba(255,255,255,.06); border: 2rpx solid rgba(106,90,224,.4); }
.seg-item.on { background: linear-gradient(135deg,#6A5AE0,#534AB7); color: #fff; border-color: #6A5AE0; }

.btn-row { display: flex; gap: 14rpx; margin-top: 18rpx; }
.btn { background: #534AB7; color: #fff; border-radius: 12rpx; padding: 14rpx 40rpx; font-size: 27rpx; text-align: center; }
.btn.ghost { background: rgba(106,90,224,.16); color: #A8A0F0; }
.btn.copy { margin-top: 16rpx; display: inline-block; padding: 14rpx 30rpx; }

.msg { margin-top: 16rpx; font-size: 26rpx; padding: 14rpx 18rpx; border-radius: 12rpx; }
.msg.ok { background: rgba(15,110,86,.30); color: #4CB89A; }
.msg.err { background: rgba(216,67,67,.22); color: #E36A6A; }

.out-label { margin-top: 22rpx; font-size: 24rpx; color: #9C99B4; }
.out-box { margin-top: 10rpx; padding: 18rpx; border-radius: 12rpx; background: rgba(255,255,255,.06); border: 2rpx solid rgba(255,255,255,.12); font-size: 26rpx; line-height: 1.6; color: #9BE7C4; word-break: break-all; font-family: monospace; }
.foot { text-align: center; color: #aaa; font-size: 24rpx; padding: 20rpx 0 40rpx; }
