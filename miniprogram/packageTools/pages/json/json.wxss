.page { padding: 24rpx; background: #12121A; min-height: 100vh; box-sizing: border-box; }
.card { background: rgba(22, 21, 34, 0.44); border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(83,74,183,0.08); }
.card-title { font-size: 32rpx; font-weight: 700; color: #A8A0F0; margin-bottom: 20rpx; }
.tarea { width: 100%; box-sizing: border-box; border: 2rpx solid rgba(255,255,255,.14); border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; background: rgba(255,255,255,.07); line-height: 1.5; min-height: 200rpx; }
.tarea.out { background: rgba(255,255,255,.07); margin-top: 16rpx; color: #2b2b35; }
.btn-row { display: flex; gap: 14rpx; margin-top: 18rpx; flex-wrap: wrap; }
.btn { background: #534AB7; color: #fff; border-radius: 12rpx; padding: 14rpx 26rpx; font-size: 27rpx; }
.btn.ghost { background: rgba(106,90,224,.16); color: #A8A0F0; }
.msg { margin-top: 16rpx; font-size: 26rpx; padding: 14rpx 18rpx; border-radius: 12rpx; }
.msg.ok { background: rgba(15,110,86,.30); color: #4CB89A; }
.msg.err { background: rgba(216,67,67,.22); color: #E36A6A; }
.foot { text-align: center; color: #aaa; font-size: 24rpx; padding: 20rpx 0 40rpx; }
