.page { padding: 24rpx; background: #F6F5F2; min-height: 100vh; box-sizing: border-box; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(83,74,183,0.08); }
.card-title { font-size: 32rpx; font-weight: 700; color: #534AB7; margin-bottom: 20rpx; }
.tarea { width: 100%; box-sizing: border-box; border: 2rpx solid #E4E1F5; border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; background: #FAF9FF; line-height: 1.5; min-height: 200rpx; }
.tarea.out { background: #F4F3FB; margin-top: 16rpx; color: #2b2b35; }
.btn-row { display: flex; gap: 14rpx; margin-top: 18rpx; flex-wrap: wrap; }
.btn { background: #534AB7; color: #fff; border-radius: 12rpx; padding: 14rpx 26rpx; font-size: 27rpx; }
.btn.ghost { background: #EEEDFE; color: #534AB7; }
.msg { margin-top: 16rpx; font-size: 26rpx; padding: 14rpx 18rpx; border-radius: 12rpx; }
.msg.ok { background: #E1F5EE; color: #0F6E56; }
.msg.err { background: #FDECEA; color: #C0392B; }
.foot { text-align: center; color: #aaa; font-size: 24rpx; padding: 20rpx 0 40rpx; }
