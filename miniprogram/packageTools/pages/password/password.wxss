.result-card { text-align: center; padding: 36rpx 24rpx; }
.pw-box {
  background: #12121A;
  border-radius: 12rpx;
  padding: 30rpx 20rpx;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  word-break: break-all;
}
.pw {
  font-family: monospace;
  font-size: 32rpx;
  color: #E8E7F0;
  letter-spacing: 2rpx;
}
.pw-empty { color: #7A7890; font-size: 26rpx; }

.strength-bar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  justify-content: center;
}
.seg {
  width: 56rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: rgba(255,255,255,.09);
}
.strength-text { font-size: 22rpx; margin-left: 10rpx; }

.actions { display: flex; gap: 16rpx; margin-top: 26rpx; }
.act {
  flex: 1;
  background: linear-gradient(135deg, #6A5AE0 0%, #534AB7 100%);
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin: 0;
}
.act.ghost {
  background: rgba(22, 21, 34, 0.44);
  color: #A8A0F0;
  border: 2rpx solid #534AB7;
}
.act[disabled] { color: rgba(83, 74, 183, 0.4); background: rgba(255,255,255,.07); border-color: #E5E3DA; }
.act::after { border: none; }

.label { font-size: 26rpx; color: #C9C7DC; margin: 16rpx 0 10rpx; }

.opt {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F0EFEB;
  font-size: 28rpx;
}
.opt:last-child { border-bottom: none; }

.switch {
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,.09);
  position: relative;
  transition: background 0.2s;
}
.switch.on { background: #534AB7; }
.knob {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(22, 21, 34, 0.44);
  top: 4rpx;
  left: 4rpx;
  transition: left 0.2s;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
}
.switch.on .knob { left: 44rpx; }
