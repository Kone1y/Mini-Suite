<view class="page">
  <view class="card result-card">
    <view class="pw-box" wx:if="{{password}}">
      <text class="pw" user-select>{{password}}</text>
    </view>
    <view class="pw-box empty" wx:else>
      <text class="pw-empty">点击下方生成按钮</text>
    </view>
    <view class="strength-bar" wx:if="{{password}}">
      <view class="seg {{strength >= 1 ? 'on' : ''}}" style="background: {{strength >= 1 ? strengthColor : ''}}"></view>
      <view class="seg {{strength >= 2 ? 'on' : ''}}" style="background: {{strength >= 2 ? strengthColor : ''}}"></view>
      <view class="seg {{strength >= 3 ? 'on' : ''}}" style="background: {{strength >= 3 ? strengthColor : ''}}"></view>
      <view class="seg {{strength >= 4 ? 'on' : ''}}" style="background: {{strength >= 4 ? strengthColor : ''}}"></view>
      <text class="strength-text" style="color: {{strengthColor}}">{{strengthText}} · {{entropy}}</text>
    </view>
    <view class="actions">
      <button class="btn-primary act" hover-class="btn-hover" bindtap="gen">生成密码</button>
      <button class="act ghost" hover-class="btn-hover" bindtap="copy" disabled="{{!password}}">复制</button>
    </view>
  </view>

  <view class="card">
    <view class="label">长度：{{length}} 位</view>
    <slider min="6" max="32" value="{{length}}" bindchange="onLength" activeColor="#534AB7" block-size="20" />

    <view class="opt" data-k="useLower" bindtap="toggle">
      <text>小写字母 a-z</text>
      <view class="switch {{useLower ? 'on' : ''}}"><view class="knob"></view></view>
    </view>
    <view class="opt" data-k="useUpper" bindtap="toggle">
      <text>大写字母 A-Z</text>
      <view class="switch {{useUpper ? 'on' : ''}}"><view class="knob"></view></view>
    </view>
    <view class="opt" data-k="useDigits" bindtap="toggle">
      <text>数字 0-9</text>
      <view class="switch {{useDigits ? 'on' : ''}}"><view class="knob"></view></view>
    </view>
    <view class="opt" data-k="useSymbols" bindtap="toggle">
      <text>符号 !@#$%</text>
      <view class="switch {{useSymbols ? 'on' : ''}}"><view class="knob"></view></view>
    </view>
    <view class="opt" data-k="excludeAmbiguous" bindtap="toggle">
      <text>排除易混淆（0O1lI）</text>
      <view class="switch {{excludeAmbiguous ? 'on' : ''}}"><view class="knob"></view></view>
    </view>
  </view>

  <view class="hint center">密码在本地生成，不会上传 · 建议 16 位以上用于重要账户</view>
</view>
