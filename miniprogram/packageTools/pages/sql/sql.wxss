.page {
  min-height: 100vh; background: #12121A;
  padding: 24rpx 28rpx 40rpx; box-sizing: border-box;
  display: flex; flex-direction: column;
}

.hero { margin-bottom: 24rpx; }
.hero-t { font-size: 42rpx; font-weight: 800; color: #E8E7F0; }
.hero-s { font-size: 22rpx; color: #8A8574; margin-top: 6rpx; }

.ls-list { display: flex; flex-direction: column; gap: 14rpx; }
.ls-item {
  display: flex; align-items: center; gap: 18rpx;
  background: rgba(22, 21, 34, 0.44); border-radius: 16rpx; padding: 22rpx;
  border: 2rpx solid rgba(83,74,183,.10);
}
.ls-item:active { opacity: .85; }
.ls-item.done { border-color: rgba(76,158,100,.45); }
.ls-no {
  width: 52rpx; height: 52rpx; border-radius: 14rpx; flex-shrink: 0;
  background: rgba(83,74,183,.10); color: #A8A0F0;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700;
}
.ls-no.ok { background: #4C9E64; color: #fff; }
.ls-main { flex: 1; min-width: 0; }
.ls-name { font-size: 27rpx; font-weight: 700; color: #E8E7F0; }
.ls-cat { font-size: 18rpx; color: #9A7A1C; background: rgba(217,166,46,.14); padding: 2rpx 10rpx; border-radius: 999rpx; margin-left: 8rpx; }
.ls-task { font-size: 21rpx; color: #8A8574; margin-top: 6rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ls-arrow { font-size: 36rpx; color: #C9C4B4; }

.play-head { display: flex; align-items: center; gap: 14rpx; margin-bottom: 16rpx; }
.back-btn {
  width: 56rpx; height: 56rpx; border-radius: 14rpx; flex-shrink: 0;
  background: rgba(22, 21, 34, 0.44); color: #A8A0F0;
  display: flex; align-items: center; justify-content: center; font-size: 32rpx;
}
.ph-name { font-size: 28rpx; font-weight: 700; color: #E8E7F0; }

.lesson-card {
  background: rgba(22, 21, 34, 0.44); border-radius: 16rpx; padding: 22rpx;
  border: 2rpx solid rgba(83,74,183,.10); margin-bottom: 16rpx;
}
.lc-t { font-size: 23rpx; color: #6B675A; line-height: 1.7; }
.lc-task { font-size: 24rpx; color: #A8A0F0; font-weight: 700; margin-top: 10rpx; line-height: 1.6; }
.lc-schema { font-size: 20rpx; color: #A5A08F; margin-top: 10rpx; font-family: monospace; }

.sql-area { margin-bottom: 16rpx; }
.sql-inp {
  width: 100%; box-sizing: border-box;
  background: #14131C; color: #6FC486;
  border-radius: 14rpx; padding: 20rpx 24rpx;
  font-size: 26rpx; font-family: monospace;
  min-height: 90rpx;
}
.sql-btns { display: flex; gap: 12rpx; margin-top: 12rpx; }
.sbtn {
  flex: 1; text-align: center; border-radius: 999rpx; padding: 16rpx 0;
  font-size: 25rpx; background: rgba(22, 21, 34, 0.44); color: #E8E7F0;
  border: 2rpx solid rgba(83,74,183,.16);
}
.sbtn.primary { background: #534AB7; color: #fff; font-weight: 700; border: none; }
.sbtn:active { opacity: .8; }

.err-box {
  background: rgba(192,86,75,.10); color: #C0564B;
  border-radius: 12rpx; padding: 14rpx 20rpx; font-size: 22rpx;
  margin-bottom: 16rpx;
}

.result-box {
  background: rgba(22, 21, 34, 0.44); border-radius: 14rpx; padding: 18rpx;
  border: 2rpx solid rgba(83,74,183,.10); margin-bottom: 16rpx;
}
.rb-meta { font-size: 20rpx; color: #A5A08F; font-family: monospace; margin-bottom: 10rpx; }
.rb-scroll { width: 100%; }
.rb-table { display: inline-block; min-width: 100%; }
.rb-row { display: flex; }
.rb-cell {
  min-width: 140rpx; padding: 12rpx 18rpx; font-size: 22rpx; color: #E8E7F0;
  border-bottom: 1rpx solid rgba(83,74,183,.08);
  font-family: monospace; white-space: nowrap; box-sizing: border-box;
}
.rb-cell.h { background: rgba(83,74,183,.07); font-weight: 700; color: #A8A0F0; }

.won-banner {
  background: rgba(76,158,100,.10); border: 2rpx solid rgba(76,158,100,.5);
  border-radius: 16rpx; padding: 20rpx; text-align: center; margin-bottom: 16rpx;
}
.wb-t { font-size: 26rpx; font-weight: 700; color: #4C9E64; }
.wb-btns { display: flex; gap: 14rpx; margin-top: 16rpx; }
.wb-btn { flex: 1; background: #4C9E64; color: #fff; border-radius: 999rpx; padding: 16rpx 0; font-size: 25rpx; font-weight: 700; }
.wb-btn.ghost { background: transparent; border: 2rpx solid #4C9E64; color: #4C9E64; }

.foot { text-align: center; font-size: 23rpx; color: #A5A08F; margin-top: 24rpx; padding: 14rpx; }
