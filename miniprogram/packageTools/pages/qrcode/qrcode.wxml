<view class="page">
  <view class="card">
    <view class="label">内容</view>
    <textarea
      class="input-area"
      placeholder="输入网址或文本，如 https://example.com"
      value="{{text}}"
      bindinput="onTextinput"
      maxlength="500"
      auto-height
    />

    <view class="label">尺寸：{{size}}px</view>
    <slider min="160" max="400" step="20" value="{{size}}" bindchange="onSizeChange" activeColor="#534AB7" block-size="20" />

    <view class="row">
      <view class="color-item">
        <view class="label">码颜色</view>
        <input class="color-input" value="{{darkColor}}" bindinput="onDarkColor" />
      </view>
      <view class="color-item">
        <view class="label">底色</view>
        <input class="color-input" value="{{lightColor}}" bindinput="onLightColor" />
      </view>
    </view>

    <button class="btn-primary" hover-class="btn-hover" bindtap="generate">生成二维码</button>
  </view>

  <view class="card result" wx:if="{{generated}}">
    <canvas
      canvas-id="qrcanvas"
      class="qr-canvas"
      style="width: {{size}}px; height: {{size}}px;"
    />
    <button class="btn-save" bindtap="save">保存到相册</button>
  </view>

  <view class="card" wx:if="{{history.length}}">
    <view class="his-head">
      <view class="his-title">生成历史</view>
      <view class="his-clear" bindtap="clearHistory">清空</view>
    </view>
    <view class="his-item" wx:for="{{history}}" wx:key="*this">
      <view class="his-text" data-text="{{item}}" bindtap="useHistory">{{item}}</view>
    </view>
  </view>
</view>
