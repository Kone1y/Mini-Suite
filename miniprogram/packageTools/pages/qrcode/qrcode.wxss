.label {
  font-size: 26rpx;
  color: #C9C7DC;
  margin: 20rpx 0 10rpx;
}
.input-area {
  background: #12121A;
  border-radius: 12rpx;
  padding: 20rpx;
  width: auto;
  min-height: 100rpx;
  font-size: 28rpx;
}
.row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.color-item {
  flex: 1;
}
.color-item:last-child {
  margin-left: 24rpx;
}
.color-input {
  background: #12121A;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  font-family: monospace;
}
.result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx;
}
.qr-canvas {
  background: rgba(22, 21, 34, 0.44);
}
.btn-save {
  margin-top: 30rpx;
  width: 100%;
  background: rgba(22, 21, 34, 0.44);
  color: #A8A0F0;
  border: 2rpx solid #534AB7;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.btn-save::after { border: none; }

.his-head { display: flex; justify-content: space-between; align-items: center; }
.his-title { font-size: 30rpx; font-weight: 600; }
.his-clear { font-size: 24rpx; color: #A32D2D; }
.his-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0EFEB;
}
.his-item:last-child { border-bottom: none; }
.his-text {
  font-size: 26rpx;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  color: #E8E7F0;
}
