.page { padding: 24rpx; background: #12121A; min-height: 100vh; box-sizing: border-box; }
.card { background: rgba(22, 21, 34, 0.44); border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(83,74,183,0.08); }
.card-title { font-size: 32rpx; font-weight: 700; color: #A8A0F0; margin-bottom: 20rpx; }
.tinput { width: 100%; box-sizing: border-box; border: 2rpx solid rgba(255,255,255,.14); border-radius: 12rpx; padding: 18rpx 20rpx; font-size: 28rpx; min-height: 88rpx; background: rgba(255,255,255,.07); font-family: 'SF Mono', Menlo, Consolas, monospace; line-height: 1.4; }
.flags { display: flex; gap: 14rpx; margin: 16rpx 0; flex-wrap: wrap; }
.flag { padding: 10rpx 20rpx; border-radius: 999rpx; font-size: 25rpx; background: rgba(255,255,255,.08); color: #8E8BA6; border: 2rpx solid transparent; }
.flag.on { background: rgba(106,90,224,.16); color: #A8A0F0; border-color: #A8A0F0; font-weight: 600; }
.tarea { width: 100%; box-sizing: border-box; border: 2rpx solid rgba(255,255,255,.14); border-radius: 12rpx; padding: 16rpx; font-size: 26rpx; background: rgba(255,255,255,.07); line-height: 1.6; min-height: 220rpx; margin-top: 16rpx; }
.err { color: #C0392B; font-size: 26rpx; margin-top: 14rpx; }
.cnt { color: #0F6E56; font-size: 26rpx; margin-top: 14rpx; font-weight: 600; }
.hl { display: block; margin-top: 14rpx; padding: 16rpx; background: rgba(255,255,255,.06); border-radius: 12rpx; font-size: 26rpx; line-height: 1.7; word-break: break-all; white-space: pre-wrap; }
.groups { margin-top: 18rpx; background: rgba(255,255,255,.07); border-radius: 14rpx; padding: 16rpx 20rpx; }
.g-title { font-size: 26rpx; color: #A8A0F0; font-weight: 600; margin-bottom: 8rpx; }
.g-row { display: flex; justify-content: space-between; padding: 6rpx 0; font-size: 26rpx; }
.g-idx { color: #8E8BA6; }
.mono { font-family: 'SF Mono', Menlo, Consolas, monospace; color: #E8E7F0; }
.foot { text-align: center; color: #aaa; font-size: 24rpx; padding: 20rpx 0 40rpx; }
