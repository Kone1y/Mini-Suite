.page { padding: 24rpx; background: #12121A; min-height: 100vh; box-sizing: border-box; }
.card { background: rgba(22,21,34,0.44); border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; border: 1rpx solid rgba(255,255,255,0.10); box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.35); }
.card-title { font-size: 30rpx; font-weight: 700; color: #A8A0F0; margin-bottom: 18rpx; }
.hint { font-size: 24rpx; color: #9C99B4; }

/* 月份导航 */
.month-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.nav-btn { width: 64rpx; height: 64rpx; line-height: 60rpx; text-align: center; border-radius: 50%; background: rgba(255,255,255,.08); color: #B9B4F2; font-size: 40rpx; }
.month-label { font-size: 34rpx; font-weight: 700; color: #E8E7F0; }

.sum-row { display: flex; }
.sum-item { flex: 1; text-align: center; }
.sum-val { font-size: 32rpx; font-weight: 700; font-family: monospace; }
.sum-val.in { color: #4CB89A; }
.sum-val.out { color: #E36A6A; }
.sum-val.bal { color: #C9C0FF; }
.sum-cap { font-size: 22rpx; color: #9C99B4; margin-top: 6rpx; }

/* 柱状图 */
.chart { display: flex; justify-content: space-between; align-items: flex-end; height: 220rpx; padding: 0 6rpx; }
.col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.bars { flex: 1; width: 40rpx; display: flex; flex-direction: column; justify-content: flex-end; gap: 4rpx; }
.bar { width: 100%; border-radius: 6rpx 6rpx 0 0; min-height: 4rpx; }
.bar.in { background: linear-gradient(180deg,#4CB89A,#2BA383); }
.bar.out { background: linear-gradient(180deg,#E36A6A,#C0392B); }
.bar.empty { flex: 1; background: rgba(255,255,255,.06); border-radius: 6rpx; }
.col-label { font-size: 20rpx; color: #9C99B4; margin-top: 8rpx; }
.legend { margin-top: 14rpx; font-size: 22rpx; }
.lg.in { color: #4CB89A; margin-right: 24rpx; }
.lg.out { color: #E36A6A; }

/* 记一笔 */
.type-row { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.type-btn { flex: 1; text-align: center; padding: 18rpx 0; border-radius: 12rpx; font-size: 28rpx; color: #B9B4F2; background: rgba(255,255,255,.06); border: 2rpx solid rgba(106,90,224,.4); }
.type-btn.on { background: linear-gradient(135deg,#6A5AE0,#534AB7); color: #fff; border-color: #6A5AE0; }
.amount-input { width: 100%; box-sizing: border-box; height: 96rpx; line-height: 86rpx; border: 2rpx solid rgba(255,255,255,.14); border-radius: 12rpx; padding: 0 24rpx; font-size: 40rpx; background: rgba(255,255,255,.07); color: #E8E7F0; margin-bottom: 16rpx; }
.ph { color: #7A7690; }
.cat-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.cat-chip { padding: 10rpx 22rpx; border-radius: 999rpx; font-size: 24rpx; color: #B9B4F2; background: rgba(255,255,255,.06); border: 2rpx solid rgba(255,255,255,.12); }
.cat-chip.on { background: rgba(106,90,224,.28); color: #fff; border-color: #6A5AE0; }
.note-input { width: 100%; box-sizing: border-box; height: 80rpx; line-height: 70rpx; border: 2rpx solid rgba(255,255,255,.14); border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; background: rgba(255,255,255,.07); color: #E8E7F0; margin-bottom: 18rpx; }
.save-btn { background: linear-gradient(135deg,#6A5AE0,#534AB7); color: #fff; text-align: center; padding: 20rpx; border-radius: 14rpx; font-size: 30rpx; font-weight: 500; box-shadow: 0 6rpx 16rpx rgba(83,74,183,.28); }

/* 明细 */
.rec { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.08); }
.rec-left { flex: 1; }
.rec-cat { font-size: 28rpx; color: #E8E7F0; }
.rec-note { font-size: 22rpx; color: #9C99B4; margin-top: 4rpx; }
.rec-right { text-align: right; margin-right: 16rpx; }
.rec-amt { font-size: 30rpx; font-weight: 700; font-family: monospace; }
.rec-amt.in { color: #4CB89A; }
.rec-amt.out { color: #E36A6A; }
.rec-date { font-size: 20rpx; color: #9C99B4; margin-top: 4rpx; }
.rec-del { width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 50%; color: #9C99B4; background: rgba(255,255,255,.06); font-size: 24rpx; }
.empty { text-align: center; color: #9C99B4; font-size: 24rpx; padding: 30rpx 0; }
.foot { text-align: center; color: #aaa; font-size: 24rpx; padding: 20rpx 0 40rpx; }
