<view class="page">
  <!-- 月份汇总 -->
  <view class="card">
    <view class="month-nav">
      <view class="nav-btn" bindtap="prevMonth">‹</view>
      <view class="month-label">{{monthLabel}}</view>
      <view class="nav-btn" bindtap="nextMonth">›</view>
    </view>
    <view class="sum-row">
      <view class="sum-item">
        <view class="sum-val in">+{{summary.in.toFixed(2)}}</view>
        <view class="sum-cap">收入</view>
      </view>
      <view class="sum-item">
        <view class="sum-val out">-{{summary.out.toFixed(2)}}</view>
        <view class="sum-cap">支出</view>
      </view>
      <view class="sum-item">
        <view class="sum-val bal">{{summary.bal.toFixed(2)}}</view>
        <view class="sum-cap">结余</view>
      </view>
    </view>
  </view>

  <!-- 近 6 月柱状图 -->
  <view class="card">
    <view class="card-title">近 6 个月</view>
    <view class="chart">
      <view class="col" wx:for="{{bars}}" wx:key="label">
        <view class="bars">
          <view class="bar in" style="height: {{item.inH}}%" wx:if="{{item.inH>0}}"></view>
          <view class="bar out" style="height: {{item.outH}}%" wx:if="{{item.outH>0}}"></view>
          <view class="bar empty" wx:if="{{item.zero}}"></view>
        </view>
        <view class="col-label">{{item.label}}</view>
      </view>
    </view>
    <view class="legend">
      <text class="lg in">■ 收入</text>
      <text class="lg out">■ 支出</text>
    </view>
  </view>

  <!-- 记一笔 -->
  <view class="card">
    <view class="card-title">记一笔</view>
    <view class="type-row">
      <view class="type-btn {{type==='out'?'on':''}}" data-type="out" bindtap="onType">支出</view>
      <view class="type-btn {{type==='in'?'on':''}}" data-type="in" bindtap="onType">收入</view>
    </view>
    <input class="amount-input" type="digit" value="{{amount}}" bindinput="onAmount" placeholder="金额（元）" />
    <view class="cat-row">
      <view class="cat-chip {{category===item?'on':''}}" wx:for="{{cats}}" wx:key="*this" data-cat="{{item}}" bindtap="onCat">{{item}}</view>
    </view>
    <input class="note-input" value="{{note}}" bindinput="onNote" placeholder="备注（可选）" placeholder-class="ph" />
    <view class="save-btn" bindtap="add">保存记录</view>
  </view>

  <!-- 明细 -->
  <view class="card">
    <view class="card-title">本月明细（{{list.length}}）</view>
    <view class="rec" wx:for="{{list}}" wx:key="id">
      <view class="rec-left">
        <view class="rec-cat">{{item.category}}</view>
        <view class="rec-note" wx:if="{{item.note}}">{{item.note}}</view>
      </view>
      <view class="rec-right">
        <view class="rec-amt {{item.type==='in'?'in':'out'}}">{{item.amountText}}</view>
        <view class="rec-date">{{item.date}}</view>
      </view>
      <view class="rec-del" data-id="{{item.id}}" bindtap="del">✕</view>
    </view>
    <view class="empty" wx:if="{{list.length===0}}">本月还没有记录，去上面记一笔吧</view>
  </view>

  <view class="foot">— 记账本 · 数据仅存于本机 —</view>
</view>
