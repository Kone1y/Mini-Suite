.label { font-size: 26rpx; color: #C9C7DC; margin: 10rpx 0 16rpx; }

.chain { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 20rpx; }
.chain-word {
  background: rgba(106,90,224,.16);
  color: #A8A0F0;
  border-radius: 10rpx;
  padding: 10rpx 20rpx;
  font-size: 26rpx;
  font-weight: 500;
}
.chain-word.del { background: #12121A; color: #A32D2D; }
.chain-empty {
  background: #12121A;
  border-radius: 12rpx;
  padding: 26rpx;
  color: #7A7890;
  font-size: 26rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.word-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.word {
  width: calc(25% - 12rpx);
  background: #12121A;
  border-radius: 14rpx;
  padding: 18rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.word-icon { font-size: 44rpx; line-height: 1; }
.word-text { font-size: 24rpx; margin-top: 8rpx; color: #E8E7F0; }

.result-card { text-align: center; padding: 40rpx 24rpx; }
.res-label { font-size: 24rpx; color: #9C99B4; }
.res-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #A8A0F0;
  margin-top: 12rpx;
}
.res-title.dim { font-size: 32rpx; color: #7A7890; }

.his-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0EFEB;
  font-size: 26rpx;
  color: #C9C7DC;
}
.his-item:last-child { border-bottom: none; }
.hint { margin-top: 6rpx; }
