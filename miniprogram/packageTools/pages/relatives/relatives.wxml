<view class="page">
  <view class="card">
    <view class="label">选择亲戚关系链（从「我」出发）</view>
    <view class="chain" wx:if="{{chain.length}}">
      <text class="chain-word" wx:for="{{chain}}" wx:key="index">{{item}}</text>
      <text class="chain-word del" bindtap="undo">⌫</text>
      <text class="chain-word del" bindtap="clear">清空</text>
    </view>
    <view class="chain-empty" wx:else>未选择，点击下方词组</view>

    <view class="word-grid">
      <view class="word" wx:for="{{words}}" wx:key="w" data-w="{{item.w}}" bindtap="addWord" hover-class="press-active">
        <text class="word-icon">{{item.icon}}</text>
        <text class="word-text">{{item.w}}</text>
      </view>
    </view>
  </view>

  <view class="card result-card" wx:if="{{result}}">
    <view class="res-label">称呼是</view>
    <view class="res-title {{result.indexOf('暂不支持') >= 0 ? 'dim' : ''}}">{{result}}</view>
  </view>

  <view class="card" wx:if="{{history.length}}">
    <view class="label">最近计算</view>
    <view class="his-item" wx:for="{{history}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="hint center">例：爸爸 + 哥哥 = 伯父（伯伯）· 过年串门必备</view>
</view>
