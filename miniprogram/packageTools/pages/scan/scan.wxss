.center-card { text-align: center; padding: 60rpx 24rpx; }
.scan-icon { font-size: 96rpx; }
.scan-tip { font-size: 30rpx; color: #2C2C2A; margin-top: 16rpx; }
.scan-tip.sub { font-size: 24rpx; color: #888780; margin-top: 8rpx; }
.scan-btn { margin-top: 40rpx; }

.res-head { display: flex; justify-content: space-between; align-items: center; }
.res-title { font-size: 30rpx; font-weight: 600; }
.res-close { font-size: 32rpx; color: #888780; padding: 4rpx 12rpx; }
.res-raw {
  background: #F6F5F2;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  word-break: break-all;
  font-family: monospace;
}
.res-raw.url { color: #534AB7; }
.res-meta { font-size: 22rpx; color: #888780; margin-top: 12rpx; }
.res-actions { display: flex; gap: 16rpx; margin-top: 20rpx; }
.act-btn {
  flex: 1;
  background: #EEEDFE;
  color: #534AB7;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin: 0;
}
.act-btn::after { border: none; }

.his-head { display: flex; justify-content: space-between; align-items: center; }
.his-title { font-size: 30rpx; font-weight: 600; }
.his-clear { font-size: 24rpx; color: #A32D2D; }
.his-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0EFEB;
}
.his-item:last-child { border-bottom: none; }
.his-left { flex: 1; min-width: 0; margin-right: 16rpx; }
.his-raw {
  font-size: 26rpx;
  word-break: break-all;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.his-time { font-size: 22rpx; color: #888780; margin-top: 4rpx; }
.his-gen {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #534AB7;
  background: #EEEDFE;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
}
