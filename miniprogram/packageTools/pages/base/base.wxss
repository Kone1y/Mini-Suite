.page { padding: 24rpx; background: #F6F5F2; min-height: 100vh; box-sizing: border-box; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(83,74,183,0.08); }
.card-title { font-size: 32rpx; font-weight: 700; color: #534AB7; margin-bottom: 20rpx; }
.row { display: flex; align-items: center; gap: 16rpx; flex-wrap: wrap; }
.tinput { flex: 1; min-width: 0; border: 2rpx solid #E4E1F5; border-radius: 12rpx; padding: 14rpx 18rpx; font-size: 28rpx; background: #FAF9FF; }
.picker { background: #534AB7; color: #fff; border-radius: 12rpx; padding: 14rpx 22rpx; font-size: 26rpx; }
.picker-text { color: #fff; }
.err { color: #C0392B; font-size: 26rpx; margin-top: 14rpx; }
.conv-list { margin-top: 18rpx; }
.conv-row { display: flex; justify-content: space-between; align-items: center; padding: 12rpx 0; border-bottom: 1rpx solid #F0EEF8; }
.conv-base { color: #888; font-size: 26rpx; }
.conv-val { color: #2b2b35; font-size: 28rpx; font-weight: 600; }
.mono { font-family: 'SF Mono', Menlo, Consolas, monospace; }
.break { word-break: break-all; }
.bit-out, .code-out { margin-top: 18rpx; background: #FAF9FF; border-radius: 14rpx; padding: 16rpx 20rpx; }
.bit-line { display: flex; justify-content: space-between; padding: 8rpx 0; font-size: 27rpx; }
.bit-line.sub { opacity: 0.7; }
.bit-label { color: #888; }
.bit-line .mono { color: #2b2b35; font-weight: 600; text-align: right; max-width: 70%; }
.big { font-size: 44rpx; color: #534AB7; }
.foot { text-align: center; color: #aaa; font-size: 24rpx; padding: 20rpx 0 40rpx; }
