.page {
  min-height: 100vh; background: #0A0A0F;
  padding: 24rpx 28rpx 40rpx; box-sizing: border-box;
  display: flex; flex-direction: column;
}

.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.langs { display: flex; gap: 8rpx; }
.lang {
  background: #1A1922; color: #776F9E;
  border-radius: 10rpx; padding: 8rpx 18rpx; font-size: 21rpx;
  border: 1rpx solid rgba(119,111,158,.25);
}
.lang.on { background: #2C9E4B; color: #fff; border-color: #2C9E4B; font-weight: 700; }
.speed {
  background: #1A1922; color: #FFD66B;
  border-radius: 10rpx; padding: 8rpx 18rpx; font-size: 21rpx;
  border: 1rpx solid rgba(255,214,107,.3);
}

.terminal {
  background: #0D0C14; border-radius: 14rpx; overflow: hidden;
  border: 1rpx solid rgba(111,196,134,.2);
  flex: 1; min-height: 520rpx;
  display: flex; flex-direction: column;
  margin-bottom: 14rpx;
}
.t-head {
  display: flex; align-items: center; gap: 10rpx;
  background: #16141F; padding: 12rpx 18rpx;
  border-bottom: 1rpx solid rgba(111,196,134,.12);
}
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.dot.r { background: #E06060; }
.dot.y { background: #E0C060; }
.dot.g { background: #60C080; }
.t-title { margin-left: 10rpx; font-size: 20rpx; color: #776F9E; font-family: monospace; }

.t-body {
  padding: 18rpx 20rpx; flex: 1;
  display: flex; flex-direction: column; justify-content: flex-end;
}
.t-text {
  font-family: 'Courier New', monospace;
  font-size: 22rpx; color: #6FC486; line-height: 1.65;
  white-space: pre-wrap; word-break: break-all;
}
.t-caret {
  color: #6FC486; font-size: 24rpx;
  animation: blink 1s step-end infinite;
}
@keyframes blink { 50% { opacity: 0; } }

.prog-row { display: flex; align-items: center; gap: 14rpx; margin-bottom: 12rpx; }
.prog-bar {
  flex: 1; height: 14rpx; background: #16141F;
  border-radius: 999rpx; overflow: hidden;
  border: 1rpx solid rgba(111,196,134,.2);
}
.prog-fill {
  height: 100%; background: linear-gradient(90deg, #2C9E4B, #6FC486);
  border-radius: 999rpx; transition: width .15s;
}
.prog-num { font-size: 22rpx; color: #6FC486; }

.tip { text-align: center; font-size: 22rpx; color: #55506E; margin-bottom: 14rpx; }

.granted-mask {
  position: fixed; top: 0; left: 0; width: 100%; height: 100%;
  background: rgba(2, 20, 6, .93);
  display: flex; align-items: center; justify-content: center;
  z-index: 99;
}
.g-box { text-align: center; padding: 60rpx; }
.g-t {
  font-family: 'Courier New', monospace;
  font-size: 56rpx; font-weight: 900; color: #2C9E4B;
  letter-spacing: 8rpx;
  text-shadow: 0 0 30rpx rgba(44,158,75,.8);
  animation: pulse 1.2s ease-in-out infinite;
}
@keyframes pulse { 50% { opacity: .6; } }
.g-s { color: #4A8A5C; font-size: 24rpx; margin-top: 20rpx; }
.g-btn {
  margin-top: 50rpx; display: inline-block;
  border: 2rpx solid #2C9E4B; color: #6FC486;
  border-radius: 999rpx; padding: 16rpx 60rpx; font-size: 26rpx;
}

.ctrl-row { display: flex; gap: 14rpx; }
.btn {
  flex: 1; border-radius: 999rpx; padding: 16rpx 0; text-align: center;
  font-size: 25rpx; background: #1A1922; color: #B9B3D4;
  border: 1rpx solid rgba(119,111,158,.3);
}
.btn.ghost { background: transparent; border: 2rpx solid #534AB7; color: #9C8FF5; }
