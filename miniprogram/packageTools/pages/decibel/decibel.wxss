.gauge-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 30rpx 30rpx;
}
.db-value {
  font-size: 110rpx;
  font-weight: 600;
  color: #E8E7F0;
  font-family: monospace;
  line-height: 1.1;
}
.db-unit {
  font-size: 34rpx;
  color: #9C99B4;
  margin-left: 10rpx;
  font-weight: 400;
}
.meter {
  width: 100%;
  height: 28rpx;
  background: rgba(255,255,255,.07);
  border-radius: 14rpx;
  overflow: hidden;
  margin-top: 40rpx;
}
.meter-fill {
  height: 100%;
  border-radius: 14rpx;
  transition: width 0.15s linear;
}
.scale {
  width: 100%;
  display: flex;
  justify-content: space-between;
  color: #7A7890;
  font-size: 20rpx;
  margin-top: 10rpx;
}
.peak-line {
  margin-top: 30rpx;
  color: #C9C7DC;
  font-size: 26rpx;
}
.db-unit.big {
  font-size: 44rpx;
  color: #E8E7F0;
  font-weight: 600;
}
