.group-line {
  font-size: 30rpx;
  font-weight: 600;
  color: #A8A0F0;
  padding: 10rpx 0 24rpx;
}
.arrow { color: #7A7890; margin-left: 8rpx; }
.row {
  display: flex;
  align-items: center;
}
.value-input {
  flex: 1;
  background: #12121A;
  border-radius: 12rpx;
  padding: 22rpx 20rpx;
  font-size: 34rpx;
  font-family: monospace;
}
.value-show {
  flex: 1;
  padding: 22rpx 20rpx;
  font-size: 34rpx;
  font-family: monospace;
  color: #0F6E56;
  word-break: break-all;
}
.unit-picker { margin-left: 20rpx; }
.unit-line {
  background: rgba(106,90,224,.16);
  color: #A8A0F0;
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
  font-size: 26rpx;
  min-width: 120rpx;
  text-align: center;
}
.equal {
  text-align: center;
  color: #9C99B4;
  font-size: 34rpx;
  margin: 16rpx 0;
}
