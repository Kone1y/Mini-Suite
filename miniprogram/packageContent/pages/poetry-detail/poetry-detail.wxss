.poem-card {
  background: rgba(22, 21, 34, 0.44);
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 48rpx 36rpx;
  box-shadow: 0 2rpx 10rpx rgba(44, 44, 42, 0.04);
  text-align: center;
}
.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #C6C0FA;
}
.meta {
  margin: 18rpx 0 34rpx;
  color: #9C99B4;
  font-size: 24rpx;
}
.line {
  font-size: 30rpx;
  line-height: 2.1;
  color: #E8E7F0;
  letter-spacing: 2rpx;
}
.actions {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: 60rpx;
}
.act {
  margin: 0 18rpx;
  padding: 16rpx 44rpx;
  border-radius: 40rpx;
  border: 2rpx solid #534AB7;
  color: #A8A0F0;
  font-size: 26rpx;
}
.share-btn {
  background: transparent;
  line-height: inherit;
}
.share-btn::after { border: none; }
