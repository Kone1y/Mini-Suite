.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx 6rpx;
  background: #F6F5F2;
  position: sticky;
  top: 0;
  z-index: 6;
}
.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #EFEEE9;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(44,44,42,0.04);
}
.search-icon { font-size: 26rpx; margin-right: 12rpx; }
.search-input { flex: 1; font-size: 26rpx; }
.search-clear { color: #B4B2A9; font-size: 28rpx; padding: 0 8rpx; }
.search-btn {
  margin-left: 16rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #6A5AE0 0%, #534AB7 100%);
  border-radius: 999rpx;
  padding: 14rpx 34rpx;
  font-size: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(83, 74, 183, 0.28);
}

.filter-bar {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx 4rpx;
  background: #F6F5F2;
}
.filter-item {
  background: #FFFFFF;
  border: 1rpx solid #EFEEE9;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: #5F5E5A;
  margin-right: 14rpx;
  transition: all 0.15s ease;
}
.filter-item.on {
  color: #534AB7;
  border-color: #534AB7;
  background: #EEEDFE;
  font-weight: 500;
}
.count { margin-left: auto; color: #B4B2A9; font-size: 22rpx; }

/* ===== 诗签卡片 ===== */
.poem {
  position: relative;
  padding: 30rpx 32rpx;
  overflow: hidden;
}
.poem-accent {
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 6rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #6A5AE0, #534AB7);
}
.poem-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #2C2C2A;
  padding-right: 40rpx;
}
.poem-meta {
  margin-top: 12rpx;
  color: #888780;
  font-size: 24rpx;
  display: flex;
  align-items: center;
}
.poem-dynasty {
  background: #EEEDFE;
  color: #534AB7;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  margin-right: 10rpx;
}
.poem-dot { margin: 0 8rpx; color: #B4B2A9; }
.poem-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #C9C7BE;
  font-size: 34rpx;
  font-weight: 300;
}

.load-line {
  text-align: center;
  color: #B4B2A9;
  font-size: 24rpx;
  padding: 30rpx 0 40rpx;
}
.load-line.empty { padding: 80rpx 0; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.empty-icon { font-size: 72rpx; margin-bottom: 6rpx; }
.empty-sub { font-size: 22rpx; color: #C9C7BE; }
