<view class="page">
  <view class="falls">
    <view class="col" wx:for="{{cols}}" wx:for-item="col" wx:key="index">
      <view class="wp-card" wx:for="{{col}}" wx:for-item="wp" wx:key="id">
        <image class="wp-img" src="{{wp.abs}}" mode="widthFix" data-path="{{wp.path}}" bindtap="preview" />
        <view class="wp-bar">
          <text class="wp-title">{{wp.title}}</text>
          <view class="wp-ops">
            <text class="op" data-path="{{wp.path}}" catchtap="fav">收藏</text>
            <text class="op strong" data-path="{{wp.path}}" catchtap="save">保存</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="load-line" wx:if="{{loading}}">加载中…</view>
  <view class="load-line" wx:elif="{{!cols[0].length}}">暂无壁纸（后台可上传）</view>
</view>
