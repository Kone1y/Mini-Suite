<view class="page">
  <view class="grid">
    <view class="cell" wx:for="{{items}}" wx:key="id">
      <image class="emoji-img" src="{{item.path}}" mode="aspectFill" data-path="{{item.path}}" bindtap="preview" />
      <view class="cell-title">{{item.title}}</view>
      <view class="cell-ops">
        <text class="op" data-path="{{item.path}}" catchtap="fav">收藏</text>
        <text class="op strong" data-path="{{item.path}}" catchtap="save">保存</text>
      </view>
    </view>
  </view>
  <view class="load-line" wx:if="{{loading}}">加载中…</view>
  <view class="load-line" wx:elif="{{!items.length}}">暂无表情包（后台可上传）</view>
</view>
