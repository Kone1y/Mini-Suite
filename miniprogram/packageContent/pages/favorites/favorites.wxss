.tabs {
  display: flex;
  background: rgba(22, 21, 34, 0.44);
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tab {
  padding: 10rpx 30rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #C9C7DC;
  background: #12121A;
  margin-right: 16rpx;
}
.tab.on {
  background: #534AB7;
  color: #FFFFFF;
}
.fav-item {
  display: flex;
  align-items: center;
  background: rgba(22, 21, 34, 0.44);
  border-radius: 16rpx;
  margin: 12rpx 24rpx;
  padding: 20rpx;
}
.thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #12121A;
}
.placeholder-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(106,90,224,.16);
  color: #A8A0F0;
  font-size: 32rpx;
}
.info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}
.t {
  font-size: 28rpx;
  color: #E8E7F0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.s {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9C99B4;
}
.del {
  font-size: 24rpx;
  color: #A32D2D;
  padding: 10rpx;
}
.load-line {
  text-align: center;
  color: #7A7890;
  font-size: 24rpx;
  padding: 24rpx 0 50rpx;
}
