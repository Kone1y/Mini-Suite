.tabs {
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 24rpx;
  position: sticky;
  top: 0;
  z-index: 5;
}
.tab {
  padding: 10rpx 30rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #5F5E5A;
  background: #F6F5F2;
  margin-right: 16rpx;
}
.tab.on {
  background: #534AB7;
  color: #FFFFFF;
}
.fav-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 12rpx 24rpx;
  padding: 20rpx;
}
.thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  background: #F6F5F2;
}
.placeholder-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EEEDFE;
  color: #534AB7;
  font-size: 32rpx;
}
.info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}
.t {
  font-size: 28rpx;
  color: #2C2C2A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.s {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #888780;
}
.del {
  font-size: 24rpx;
  color: #A32D2D;
  padding: 10rpx;
}
.load-line {
  text-align: center;
  color: #B4B2A9;
  font-size: 24rpx;
  padding: 24rpx 0 50rpx;
}
