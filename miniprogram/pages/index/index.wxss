page { background: #12121A; }

.page {
  min-height: 100vh;
  padding-bottom: 30rpx;
  position: relative;
}

/* ===== 壁纸背景层 ===== */
.page-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
}
/* 深色遮罩：壁纸透出氛围，同时保持深色主题可读性 */
.page-veil {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(18,18,26,.86) 0%, rgba(18,18,26,.78) 45%, rgba(18,18,26,.90) 100%);
  z-index: 1;
}
/* 内容提层 */
.hero, .stat-bar, .sec-title, .mod-swiper, .picks, .foot-brand { position: relative; z-index: 2; }

/* ===== 深色沉浸 hero（壁纸之上） ===== */
.hero {
  position: relative;
  padding: 44rpx 36rpx 52rpx;
  background: linear-gradient(165deg, rgba(28,27,46,.55) 0%, rgba(23,22,40,.38) 40%, rgba(18,18,26,.15) 100%);
  overflow: hidden;
  color: #fff;
}
/* 点阵背景 */
.hero-dots {
  position: absolute; top: 0; left: 0;
  width: 100%; height: 100%;
  background-image: radial-gradient(rgba(139,155,212,.14) 1.5rpx, transparent 1.5rpx);
  background-size: 34rpx 34rpx;
}
/* 弥散光斑 */
.hero-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: .5;
}
.hero-glow.g1 {
  width: 380rpx; height: 380rpx;
  background: rgba(103,81,220,.55);
  right: -110rpx; top: -120rpx;
  animation: glowFloat 9s ease-in-out infinite;
}
.hero-glow.g2 {
  width: 300rpx; height: 300rpx;
  background: rgba(46,140,200,.35);
  left: -100rpx; bottom: -140rpx;
  animation: glowFloat 11s ease-in-out infinite 2s;
}
@keyframes glowFloat {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(-24rpx, 20rpx) scale(1.12); }
}
.hero-top {
  position: relative;
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 44rpx;
}
.hero-date { font-size: 22rpx; color: rgba(255,255,255,.55); font-family: monospace; }
.hero-status {
  font-size: 20rpx; border-radius: 999rpx; padding: 4rpx 16rpx;
  font-family: monospace;
}
.hero-status.ok { background: rgba(76,217,149,.16); color: #7FE0A8; }
.hero-status.bad { background: rgba(255,149,128,.16); color: #FFB4A2; }

.hero-emoji { position: relative; font-size: 72rpx; margin-bottom: 8rpx; }
.hero-title {
  position: relative;
  font-size: 84rpx; font-weight: 900; letter-spacing: 6rpx;
  background: linear-gradient(120deg, #FFFFFF 20%, #B8AAFF 55%, #7FD8FF 90%);
  -webkit-background-clip: text;
  color: transparent;
  margin-bottom: 16rpx;
}
.hero-typed {
  position: relative;
  font-size: 26rpx; color: rgba(255,255,255,.78);
  min-height: 40rpx;
  font-family: monospace;
}
.cursor {
  animation: cursorBlink 1s step-end infinite;
  color: #9C8FF5;
}
@keyframes cursorBlink { 50% { opacity: 0; } }

.hero-tags { position: relative; display: flex; gap: 12rpx; margin-top: 26rpx; flex-wrap: wrap; }
.tag {
  font-size: 21rpx; color: rgba(255,255,255,.82);
  background: rgba(255,255,255,.10);
  border: 1rpx solid rgba(255,255,255,.16);
  border-radius: 999rpx; padding: 8rpx 22rpx;
}

/* ===== 数据统计条（玻璃） ===== */
.stat-bar {
  display: flex;
  margin: 24rpx 28rpx 0;
  background: rgba(255,255,255,.07);
  border: 1rpx solid rgba(255,255,255,.14);
  border-radius: 22rpx;
  padding: 24rpx 0;
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}
.stat { flex: 1; text-align: center; }
.stat-v {
  font-size: 44rpx; font-weight: 900;
  background: linear-gradient(120deg, #B8AAFF, #7FD8FF);
  -webkit-background-clip: text; color: transparent;
  font-family: monospace;
}
.stat-l { font-size: 21rpx; color: rgba(255,255,255,.5); margin-top: 6rpx; }

/* ===== 区块标题 ===== */
.sec-title {
  font-size: 27rpx; font-weight: 700; color: #C9C0FF;
  margin: 40rpx 32rpx 18rpx;
  letter-spacing: 2rpx;
}

/* ===== 模块轮播（玻璃拟态卡：磨砂透底 + 模块色点缀） ===== */
.mod-swiper { height: 400rpx; }
.mag-card {
  position: relative;
  height: 360rpx;
  margin: 8rpx 14rpx;
  border-radius: 32rpx;
  color: #fff;
  overflow: hidden;
  display: flex; flex-direction: column; justify-content: center;
  padding: 0 44rpx;
  /* 玻璃底：透出壁纸，blur 磨砂（不支持 blur 的机型退化为纯半透依然可读） */
  background: rgba(22, 21, 34, 0.44);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1.5rpx solid rgba(255,255,255,.22);
  box-shadow: 0 18rpx 40rpx -18rpx rgba(0,0,0,.5);
}
/* 模块色只做点缀：顶部渐变色带 + 弥散色晕 */
.mag-accent {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 12rpx;
}
.mag-halo {
  position: absolute;
  width: 300rpx; height: 300rpx;
  border-radius: 50%;
  filter: blur(50rpx);
  opacity: .38;
  right: -70rpx; top: -70rpx;
}
.mag-num {
  position: absolute; right: 30rpx; top: 26rpx;
  font-size: 100rpx; font-weight: 900;
  color: rgba(255,255,255,.14);
  font-family: monospace;
}
.mag-deco {
  position: absolute;
  width: 240rpx; height: 240rpx; border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,.14);
  right: -70rpx; bottom: -100rpx;
  background: transparent;
}
.mag-icon {
  width: 100rpx; height: 100rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,.16);
  border: 1.5rpx solid rgba(255,255,255,.28);
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx;
  margin-bottom: 16rpx;
}
.mag-title {
  font-size: 44rpx; font-weight: 800; letter-spacing: 2rpx;
  text-shadow: 0 2rpx 10rpx rgba(0,0,0,.4);
}
.mag-desc {
  font-size: 23rpx; opacity: .88; margin-top: 10rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.4);
}
.mag-foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 30rpx;
}
.mag-count {
  font-size: 21rpx;
  background: rgba(255,255,255,.16);
  border: 1rpx solid rgba(255,255,255,.24);
  border-radius: 999rpx; padding: 8rpx 22rpx;
  backdrop-filter: blur(8rpx);
}
.mag-go { font-size: 24rpx; font-weight: 700; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.4); }

/* ===== 精选直通 ===== */
.picks {
  display: flex; flex-wrap: wrap;
  padding: 0 22rpx;
}
.pick {
  width: 25%;
  display: flex; flex-direction: column; align-items: center;
  padding: 18rpx 0;
}
.pick-brick {
  width: 96rpx; height: 96rpx;
  border-radius: 28rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 46rpx;
  box-shadow: 0 8rpx 18rpx -10rpx rgba(0,0,0,.5);
  margin-bottom: 12rpx;
  border: 1.5rpx solid rgba(255,255,255,.30);
}
.pick:active .pick-brick { transform: scale(.92); }
.pick-name {
  font-size: 21rpx; color: rgba(255,255,255,.72);
  max-width: 150rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

.foot-brand {
  text-align: center;
  color: rgba(255,255,255,.28);
  font-size: 21rpx;
  padding: 50rpx 0 30rpx;
}
