.page { min-height: 100vh; background: #12121A; padding-bottom: 40rpx; position: relative; }

/* ---------- 自定义背景层 ---------- */
.bg-layer {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 0;
}
/* 深色遮罩：压暗壁纸统一玻璃基调（无背景时 page 自带深底色）；按壁纸亮度分档（JS 切换） */
.bg-veil {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(180deg, rgba(18,18,26,.74) 0%, rgba(18,18,26,.52) 45%, rgba(18,18,26,.68) 100%);
  z-index: 1;
}
/* 暗壁纸：遮罩调轻，让壁纸呼吸 */
.bg-veil.veil-dark {
  background: linear-gradient(180deg, rgba(18,18,26,.62) 0%, rgba(18,18,26,.40) 45%, rgba(18,18,26,.56) 100%);
}
/* 亮壁纸：遮罩加强，保文字可读 */
.bg-veil.veil-light {
  background: linear-gradient(180deg, rgba(18,18,26,.82) 0%, rgba(18,18,26,.60) 45%, rgba(18,18,26,.74) 100%);
}
/* 有背景时内容层提权 + 卡片磨砂 */
.page > .head, .page > .recent, .page > .cats, .page > .grid, .page > .foot { position: relative; z-index: 2; }

/* ---------- 沉浸头（波浪收边） ---------- */
.head {
  position: relative;
  padding: 100rpx 32rpx 88rpx;
  color: #fff;
  overflow: hidden;
}
.head-back {
  position: absolute; top: 56rpx; left: 28rpx; z-index: 10;
  width: 64rpx; height: 64rpx; line-height: 58rpx;
  text-align: center; font-size: 44rpx; color: #fff;
  background: rgba(255,255,255,.18);
  border-radius: 50%;
}
.head-back:active { background: rgba(255,255,255,.3); }
.head-bg-btn {
  position: absolute; top: 60rpx; right: 28rpx; z-index: 10;
  background: rgba(255,255,255,.18);
  border: 1rpx solid rgba(255,255,255,.28);
  border-radius: 999rpx;
  padding: 8rpx 22rpx; font-size: 22rpx;
}
.head-bg-btn:active { background: rgba(255,255,255,.3); }
.head-icon { font-size: 72rpx; margin-bottom: 6rpx; }
.head-title { font-size: 48rpx; font-weight: 800; letter-spacing: 2rpx; }
.head-sub { font-size: 24rpx; opacity: .85; margin-top: 8rpx; }
.deco {
  position: absolute; border-radius: 50%;
  background: rgba(255,255,255,.10);
}
.d1 { width: 240rpx; height: 240rpx; right: -70rpx; top: -70rpx; }
.d2 { width: 150rpx; height: 150rpx; right: 130rpx; bottom: 10rpx; background: rgba(255,255,255,.08); }
.d3 { width: 80rpx; height: 80rpx; left: 50rpx; bottom: 70rpx; background: rgba(255,255,255,.07); }
/* 双波浪收边（与深色基调一致） */
.wave {
  position: absolute;
  border-radius: 50%;
}
.w1 { width: 130%; height: 120rpx; left: -15%; bottom: -72rpx; border-radius: 60rpx 60rpx 0 0; background: rgba(18,18,26,.40); }
.w2 { width: 130%; height: 100rpx; left: -15%; bottom: -64rpx; border-radius: 50% 50% 0 0; background: #12121A; }
.clear-bg {
  position: absolute; right: 28rpx; bottom: 96rpx; z-index: 10;
  background: rgba(0,0,0,.25);
  border-radius: 999rpx;
  padding: 8rpx 20rpx; font-size: 21rpx;
}

/* ---------- 最近使用（玻璃 chips） ---------- */
.recent { padding: 26rpx 0 0 28rpx; }
.recent-title {
  font-size: 24rpx; color: rgba(255,255,255,.55);
  margin-bottom: 16rpx; letter-spacing: 2rpx;
}
.recent-scroll { white-space: nowrap; }
.recent-item {
  display: inline-flex; align-items: center; gap: 10rpx;
  background: rgba(22,21,34,.48);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255,255,255,.18);
  border-radius: 999rpx;
  padding: 12rpx 26rpx 12rpx 16rpx;
  margin-right: 14rpx;
  box-shadow: 0 4rpx 14rpx -8rpx rgba(0,0,0,.5);
}
.recent-item:active { transform: scale(.95); }
.recent-icon { font-size: 30rpx; }
.recent-name { font-size: 24rpx; color: #FFFFFF; }

/* ---------- 分类 chips（玻璃 + 渐变激活） ---------- */
.cats {
  white-space: nowrap;
  padding: 26rpx 28rpx 6rpx;
  box-sizing: border-box;
}
.cat-chip {
  display: inline-block;
  font-size: 25rpx; color: rgba(255,255,255,.75);
  background: rgba(22,21,34,.48);
  backdrop-filter: blur(16rpx);
  -webkit-backdrop-filter: blur(16rpx);
  border: 1rpx solid rgba(255,255,255,.18);
  border-radius: 999rpx;
  padding: 10rpx 30rpx;
  margin-right: 14rpx;
  transition: transform .15s ease;
}
.cat-chip.on { color: #fff; font-weight: 600; transform: scale(1.04); border-color: transparent; }

/* ---------- 大卡网格（深色玻璃 + 色砖点缀 + 入场） ---------- */
.grid {
  display: flex; flex-wrap: wrap;
  padding: 20rpx 18rpx 0;
  box-sizing: border-box;
}
.card {
  width: calc(50% - 18rpx);
  margin: 0 9rpx 18rpx;
  background: rgba(22, 21, 34, 0.44);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 26rpx;
  padding: 34rpx 26rpx 28rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 22rpx -14rpx rgba(0,0,0,.4);
  display: flex; flex-direction: column; align-items: center;
  border: 1.5rpx solid rgba(255,255,255,.20);
  position: relative;
  opacity: 0;
}
.card-in { animation: cardIn .45s ease forwards; }
@keyframes cardIn {
  from { opacity: 0; transform: translateY(26rpx) scale(.96); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.card-press { transform: scale(.96); opacity: .85; }
.card-icon-wrap {
  width: 108rpx; height: 108rpx;
  border-radius: 30rpx;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 18rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 18rpx -8rpx rgba(0,0,0,.45);
}
.card-icon { font-size: 56rpx; }
.card-custom-img { width: 100%; height: 100%; }
/* 深色玻璃上的文字用亮色 */
.card-name { font-size: 28rpx; font-weight: 700; color: #FFFFFF; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.5); }
.card-sub { font-size: 21rpx; color: rgba(255,255,255,.62); margin-top: 6rpx; }
.card-customized {
  position: absolute; top: 12rpx; right: 12rpx;
  font-size: 20rpx;
  background: rgba(255,255,255,.30);
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
}

.empty {
  width: 100%; text-align: center;
  padding: 70rpx 0; color: rgba(255,255,255,.5); font-size: 25rpx;
}
.empty-icon { font-size: 56rpx; display: block; margin-bottom: 12rpx; }

.foot { text-align: center; color: rgba(255,255,255,.30); font-size: 20rpx; padding: 26rpx 0 10rpx; position: relative; z-index: 2; }

/* ---------- 悬浮操作条（自定义导航无原生返回键，长列表下滑后浮现） ---------- */
.floatbar {
  position: fixed;
  left: 24rpx; bottom: 44rpx;
  display: flex; flex-direction: column; gap: 20rpx;
  z-index: 50;
  opacity: 0; transform: translateY(24rpx);
  pointer-events: none;
  transition: opacity .25s ease, transform .25s ease;
}
.floatbar.show { opacity: 1; transform: none; pointer-events: auto; }
.fbtn {
  width: 88rpx; height: 88rpx; line-height: 86rpx;
  text-align: center; font-size: 44rpx; color: #fff;
  background: rgba(106,90,224,.62);
  backdrop-filter: blur(12rpx); -webkit-backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(255,255,255,.28);
  border-radius: 50%;
  box-shadow: 0 8rpx 22rpx -8rpx rgba(0,0,0,.5);
}
.fbtn:active { transform: scale(.92); background: rgba(106,90,224,.82); }
.fbtn.back { font-size: 52rpx; background: rgba(22,21,34,.62); }
.fbtn.back:active { background: rgba(22,21,34,.82); }
