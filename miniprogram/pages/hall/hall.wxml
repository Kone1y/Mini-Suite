<view class="page" wx:if="{{mod}}">
  <!-- 自定义背景层（image 绝对定位铺底，WXSS 不支持本地 background-image） -->
  <image wx:if="{{bgImage}}" class="bg-layer" src="{{bgImage}}" mode="aspectFill"></image>
  <view wx:if="{{bgImage}}" class="bg-veil {{veilCls}}"></view>

  <!-- 沉浸式模块头（渐变 + 波浪收边） -->
  <view class="head" style="background: linear-gradient(135deg, {{mod.color}} 0%, {{mod.color2}} 100%)">
    <view class="head-back" bindtap="goHome">‹</view>
    <view class="head-bg-btn" bindtap="onPickBg">🖼 背景</view>
    <view class="head-icon">{{mod.icon}}</view>
    <view class="head-title">{{mod.title}}</view>
    <view class="head-sub">{{mod.desc}} · {{mod.tools.length}} 个条目</view>
    <!-- 装饰 -->
    <view class="deco d1"></view>
    <view class="deco d2"></view>
    <view class="deco d3"></view>
    <!-- 波浪收边 -->
    <view class="wave w1"></view>
    <view class="wave w2"></view>
    <!-- 有自定义背景时给恢复入口 -->
    <view class="clear-bg" wx:if="{{bgImage}}" bindtap="onClearBg">↩ 恢复默认背景</view>
  </view>

  <!-- 最近使用 -->
  <view class="recent" wx:if="{{recent.length}}">
    <view class="recent-title">最近使用</view>
    <scroll-view class="recent-scroll" scroll-x enable-flex>
      <view class="recent-item" wx:for="{{recent}}" wx:key="url" data-url="{{item.url}}" bindtap="goTool">
        <text class="recent-icon">{{item.icon}}</text>
        <text class="recent-name">{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 分类 chips -->
  <scroll-view class="cats" scroll-x wx:if="{{mod.cats.length > 1}}">
    <view
      class="cat-chip {{catIdx === index ? 'on' : ''}}"
      wx:for="{{mod.cats}}"
      wx:key="key"
      data-idx="{{index}}"
      bindtap="onCat"
      style="{{catIdx === index ? 'background: linear-gradient(135deg,' + mod.color + ',' + mod.color2 + ');border-color:' + mod.color + ';box-shadow:0 4rpx 12rpx -4rpx' + mod.color : ''}}"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 工具大卡网格（多彩色砖 + 自定义图标 + 错落入场） -->
  <view class="grid">
    <view
      class="card {{animated ? 'card-in' : ''}}"
      wx:for="{{shownTools}}"
      wx:key="url"
      hover-class="card-press"
      data-url="{{item.url}}"
      data-name="{{item.name}}"
      bindtap="goTool"
      bindlongpress="onCardLongPress"
      style="animation-delay: {{index * 45}}ms"
    >
      <view class="card-icon-wrap" style="background: linear-gradient(135deg, {{item.brick.c1}}, {{item.brick.c2}})">
        <image wx:if="{{item.iconSrc}}" class="card-custom-img" src="{{item.iconSrc}}" mode="aspectFill"></image>
        <text wx:else class="card-icon">{{item.icon}}</text>
      </view>
      <view class="card-name">{{item.name}}</view>
      <view class="card-sub">{{item.sub}}</view>
      <view class="card-customized" wx:if="{{item.iconSrc}}">🖼</view>
    </view>
    <!-- 空分类态 -->
    <view class="empty" wx:if="{{!shownTools.length}}">
      <text class="empty-icon">🍂</text>
      <text>这个分类暂时没有内容</text>
    </view>
  </view>

  <view class="foot">— {{mod.title}} · 长按卡片可自定义图标 —</view>

  <!-- 悬浮操作条：长列表下滑后浮现，回顶 / 返回主页（自定义导航无原生返回键） -->
  <view class="floatbar {{scrolled ? 'show' : ''}}">
    <view class="fbtn" bindtap="toTop">↑</view>
    <view class="fbtn back" bindtap="goHome">‹</view>
  </view>
</view>
